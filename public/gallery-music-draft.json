    { "track": "driftwood", "cup": "beach", "song": "candidates/unity.mp3", "why": "Pounding piano and drums at 140 bpm: intense without horror, and level from start to end like the storm.", "options": ["candidates/celtic_impulse.mp3", "candidates/morgana_rides.mp3", "desert_of_lost_souls.mp3"] },
