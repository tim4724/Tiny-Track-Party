    { "track": "powder", "cup": "snow", "song": "wallpaper.mp3", "why": "Clean, bright resort-lodge pop for the ski resort that opens the cup.", "options": ["digital_lemonade.mp3", "glitter_blast.mp3"] },
    { "track": "flurry", "cup": "snow", "song": "glitter_blast.mp3", "why": "Glockenspiel, flutes and ukulele sparkle like light snowfall over the frozen lake and its hamlet.", "options": ["digital_lemonade.mp3", "new_friendly.mp3"] },
    { "track": "glacier", "cup": "snow", "song": "new_friendly.mp3", "why": "Round synths and a choir that keeps building, as big and cold as the ice field.", "options": ["digital_lemonade.mp3", "wallpaper.mp3"] },
    { "track": "avalanche", "cup": "snow", "song": "cloud_dancer.mp3", "why": "The fastest snow song (214 bpm) for the cup's hardest run down the slide paths.", "options": ["digital_lemonade.mp3", "new_friendly.mp3"] },
    { "track": "ribbon", "cup": "backyard", "song": "hyperfun.mp3", "why": "Ragtime piano, tuba and ukulele: a village band for the church green, maypole and fete.", "options": ["happy_happy_game_show.mp3", "happy_bee.mp3"] },
