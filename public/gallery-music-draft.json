    { "track": "tangle", "cup": "backyard", "song": "vivacity.mp3", "why": "Vibraphone shimmer and an easy swing for the brook, the turning millwheel and the duck pond.", "options": ["feelin_good.mp3", "happy_bee.mp3"] },
    { "track": "cloverleaf", "cup": "backyard", "song": "happy_bee.mp3", "why": "Bright 1950s organ rock, a bee song for the park in blossom, its bandstand and railway.", "options": ["vivacity.mp3", "happy_happy_game_show.mp3"] },
    { "track": "wash", "cup": "canyon", "song": "surf_shimmy.mp3", "why": "Fast, twangy surf-rock guitar for the run down the dry wash and through its fords.", "options": ["desert_of_lost_souls.mp3", "still_pickin.mp3"] },
    { "track": "gulch", "cup": "canyon", "song": "still_pickin.mp3", "why": "Banjo pickin' and stompin' is gold-rush music for the mine, its ore train and stamp mill.", "options": ["bama_country.mp3", "surf_shimmy.mp3"] },
    { "track": "crag", "cup": "canyon", "song": "bama_country.mp3", "why": "Harmonica-and-fiddle country for the ranch, its corral and the turning windpump.", "options": ["still_pickin.mp3", "surf_shimmy.mp3"] },
