# Native wasm renderer build output (scripts/build-wasm.sh) + its CMake dir.
# public/native/ is NOT ignored: the renderer's wasm artifacts are CHECKED IN,
# like the sim's (public/display/engine/native/). Building them needs the
# Filament fork, which CI does not carry — so the preview deploy can only serve
# what the repo holds. Rebuild with scripts/build-wasm.sh and commit the result
# whenever the renderer changes.
native/web/build/
*.log
.DS_Store
# Audition candidate dumps — 760 MB of rejected sound candidates that were
# force-added once and then shipped in the Docker image for months:
#   _stk-audition/    STK SFX (mixed CC-BY-SA/GPL/CC0)
#   _engine-audition/ OpenGameArt engine clips (mostly CC0)
#   _music-pool/      race-music candidates (all CC-BY 4.0)
# They now live ONLY on the `audio-auditions` branch, which also carries the
# galleries that browse them (/sfx-audition.html and friends) and
# scripts/build-music-pool.mjs. Do NOT `git add -f` them back onto main: branch
# from audio-auditions for the next round, then ship only the promoted files.
public/assets/audio/_stk-audition/
public/assets/audio/_engine-audition/
public/assets/audio/_music-pool/
# Local-only Claude Code state — keeps the .claude/ root committable for shared
# project settings/hooks while excluding per-user runtime files (worktrees,
# local settings, scheduler lock).
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
native/build/
