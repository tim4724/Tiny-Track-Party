# Machine-specific SDK path. Gradle writes this itself if Android Studio opens
# the project; the build scripts set ANDROID_HOME instead.
local.properties

# Android Studio's own project state, from that same cause. Nothing in the
# build reads it, and it carries per-machine paths and window layout.
.idea/

# Gradle's own state.
.gradle/
build/
app/build/

# The daemon JVM criteria, written by `updateDaemonJvm` when the IDE opened the
# project. Gradle's own advice is to COMMIT this file, and that advice assumes
# the daemon JVM is a decision the project has MADE. This one was not: it
# arrived from an IDE and pins toolchain 21, where compileOptions and the
# workflows' setup-java are both 17. Committed, every build here and in CI
# would fetch a JDK nobody chose. Adopt daemon JVM criteria deliberately or
# not at all.
gradle/gradle-daemon-jvm.properties

# BUILD OUTPUT, not artifacts. native/scripts/build-runtime-android.sh writes
# these, and unlike public/display/engine/native/ttp_runtime.wasm they are NOT
# checked in: no test in the tree replays them, and two ABIs of a 5-7 MB .so per
# commit would dwarf the repo. Same call the tvOS script makes for its .a.
app/src/main/jniLibs/

# Staged by shells/androidtv/scripts/stage-assets.sh from the one place each
# thing is authored. Committing them would be a second copy of the kit, the
# cues, the materials and design-tokens.json.
app/src/main/assets/

# Likewise, and for the same reason — but these two must be RESOURCES rather
# than assets: the window background and the launcher tile are both read before
# any app code runs. scripts/bake-wordmark.mjs is where they come from.
app/src/main/res/drawable-nodpi/
/keystore.properties
