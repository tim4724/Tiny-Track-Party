<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A window, and nothing else. Every pixel inside it is either the Filament
         surface or Compose drawing from design-tokens.json, so a platform theme
         would only get a chance to be wrong: no action bar, no Material colours,
         no system decoration.

         windowBackground is the SPLASH (drawable/splash.xml): the paper this
         app's first painted frame actually is, with the wordmark on it. It shows
         for the frames between the Activity appearing and the first Filament
         present. It used to be a flat ink #2A2735, guarding against "a white
         flash on a dark TV" — but this app is not dark, so that was a dark step
         in front of a light app. See splash.xml. -->
    <style name="Theme.TinyTrackParty" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
