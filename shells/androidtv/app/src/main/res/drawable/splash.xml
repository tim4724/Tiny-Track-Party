<?xml version="1.0" encoding="utf-8"?>
<!-- The window background, which IS this app's splash.
     
     It is what the window manager composites between the Activity appearing and
     the first Filament present, before a line of app code has run — so it cannot
     ask Compose for the wordmark and a VectorDrawable cannot set type. The mark
     is therefore a bake of the real `.wordmark` rule from theme.css
     (scripts/bake-wordmark.mjs), staged into res/ by stage-assets.sh.

     PAPER, NOT INK. This was a flat #2A2735 on the stated grounds that "a white
     flash on a dark TV in a dark room is the one moment of this app a player
     would call broken" — but this app is not dark. Its first painted frame is
     the warm paper diorama (see the lobby shots), so ink was a dark step in
     front of a light app rather than a guard against a bright one. Matching the
     first frame removes a transition instead of adding one.

     The in-app boot cover (ttp_ui_cover) picks up where this leaves off: this
     covers window-appear to first-present, that covers first-present to the
     first frame with a scene actually on it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/paper" />
    <item
        android:drawable="@drawable/wordmark"
        android:gravity="center"
        android:width="720dp"
        android:height="300dp" />
</layer-list>
