<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher tile. 320x180 is the Android TV banner size, and a banner is
     REQUIRED for a LEANBACK_LAUNCHER app: without one the app installs and then
     cannot be found on the home screen.

     PLACEHOLDER, and deliberately marked as one. It uses the real palette
     (paper, ink, red, green, blue, purple from theme.css) and the sticker
     grammar — flat colour, thick ink outline, hard offset shadow, slight
     rotation — but it is not the wordmark. The wordmark is TYPE, and a vector
     drawable has no text primitive, so the honest way to produce it is to
     render `.wordmark` through the real theme.css offline and bake a PNG, the
     way the item icons and car thumbnails are already baked. That is a design
     task, not a blocker for a running game. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- warm paper -->
    <path
        android:fillColor="#FFF6EB"
        android:pathData="M0,0h320v180h-320z" />

    <!-- grass band -->
    <path
        android:fillColor="#A9DF83"
        android:pathData="M0,140h320v40h-320z" />

    <!-- the four chrome colours as a row of die-cut stickers, each with its
         hard zero-blur offset shadow drawn first. red / green / blue / purple
         ONLY: yellow and pink are vetoed in chrome. -->
    <group android:pivotX="160" android:pivotY="80" android:rotation="-2">
        <path android:fillColor="#2A2735" android:pathData="M47,45h58v58h-58z" />
        <path android:fillColor="#FF5040" android:pathData="M44,42h58v58h-58z" />
        <path android:fillColor="#2A2735" android:pathData="M111,45h58v58h-58z" />
        <path android:fillColor="#22C46E" android:pathData="M108,42h58v58h-58z" />
        <path android:fillColor="#2A2735" android:pathData="M175,45h58v58h-58z" />
        <path android:fillColor="#339CF2" android:pathData="M172,42h58v58h-58z" />
        <path android:fillColor="#2A2735" android:pathData="M239,45h58v58h-58z" />
        <path android:fillColor="#A259E6" android:pathData="M236,42h58v58h-58z" />
    </group>
</vector>
