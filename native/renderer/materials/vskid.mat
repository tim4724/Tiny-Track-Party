// Skid STAMPS into the track-space rubber layer (see vroad.mat's skid tap).
//
// The target is an offscreen R8 texture whose axes are the road's own
// (s / length, lat mapped across the height). Each committed trail segment
// arrives as one quad already in clip space — vertexDomain:device, no camera —
// and lands additively; the ink is permanent until the race-restart wipe,
// which is a clear on this same pass (there is no decay material — that keeps
// the layer's recurring GPU cost at just these quads). Additive is ONE/ONE,
// so overlapping trails darken where they cross, which is what rubber does;
// vroad caps the sum so a donut spot cannot go pure black.
//
// The feather is the mesh pool's old 4-column profile, carried in the vertex
// colour: the outer columns hold zero ink, so between the inner pair the mark
// is one even band and only the last sliver ramps off.
material {
    name : TtpVskid,
    shadingModel : unlit,
    vertexDomain : device,
    blending : add,
    culling : none,
    // The target has no depth attachment; nothing here may touch depth.
    depthWrite : false,
    depthCulling : false,
    requires : [ color ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // baseColor.r is the ink added to the R8 target; g/b go nowhere.
        material.baseColor = getColor();
    }
}
