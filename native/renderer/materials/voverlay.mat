// The 2D cell overlay: the split-screen dividers and the per-player steer bar.
//
// WHY THE RENDERER DRAWS THESE AT ALL. architecture.md keeps the HUD in the
// shells because the chrome is a UI-TOOLKIT problem (variable-font shaping,
// cards, transitions) and Filament is not one. The line that admits exactly
// these two and nothing else:
//
//     cell-anchored AND textless -> renderer
//     anything carrying type or card chrome -> shell
//
// A rounded rect with a translating fill has no type in it, is pinned to a cell
// whose geometry is already C++ (ttp_grid_cell), and is the ONLY HUD element
// that wants every frame — so moving it leaves the whole remaining HUD a ~6 Hz
// poll, which is a far cleaner contract for three shells than each writing its
// own 60 Hz animation over a GL surface. The place ordinal, the name chip, the
// item slot, the FINISHED card and the reconnect QR all stay in the shell.
//
// ONE MATERIAL, TWO SHAPES, because the whole bar composites in one fragment:
//   pad == 0  a plain rect in `ink`: a divider rule
//   pad >  0  the steer bar, the Toy Box way (the phone's .steer__track is its
//             twin): a GLASS pill, `ink` at its own alpha with no outline; a
//             thin `tick` at the centre; then the livery fill, a flat pill
//             INSET by `pad` on every side. It is read, never pressed, so it
//             wears glass and paint, never plastic.
// The three layers composite HERE, premultiplied src-over in that order, and
// the quad hands the framebuffer one premultiplied colour. So the tick and the
// fill's antialiased edges mix against the glass exactly as CSS mixes a child
// over its parent, and only the glass itself (and each outer edge's coverage)
// really blends with the race under it.
//
// COLOUR SPACE. This draws straight onto the swap chain with post-processing
// off (after the present pass where there is one, and otherwise inside each
// race cell's own pass, last in its blend order; TtpRenderer::drawOverlay has
// the fold) so a value written here IS the on-panel sRGB value, and the
// framebuffer blend that is left (the see-through glass over the race, and the
// shapes' antialiased edges; the divider itself is opaque black) blends sRGB
// against sRGB, like CSS compositing. The glass is where that matters: it is a
// real translucent layer over the scene now, and authoring it in the scene's
// linear space and letting vpresent grade it would blend in LINEAR instead,
// which is a visibly different answer: ink at 50 % over white is about 0.58 in
// sRGB and 0.73 in linear, a much paler glass.
//
// Units are DEVICE pixels throughout, with no UI unit anywhere: drawOverlay
// derives the bar from the cell's and the screen's heights, and the rules'
// weight from the canvas,
// so nothing here needs a scale from the shell. Every px-valued parameter and
// the varying carry it at high precision: a mediump float has ~4 px of slack at
// 4 K, which would smear a 4 px rule.
//
// EVERY VECTOR PARAMETER IS A float4, used or not. A highp float3 in a block
// like this read back at the wrong scale on the Android box's Vulkan
// (vshadow.mat, 2026-10-14) while GL was right; float4 sidesteps the layout
// question rather than relying on which neighbour a float3 happens to have.
material {
    name : TtpVoverlay,
    parameters : [
        // the quad's own size, so the vertex stage can hand the fragment real
        // pixels rather than a 0..1 corner
        { type : float2, name : size,    precision : high },
        // x radius, y fill inset (0 = a divider), z centre-tick width, w unused
        // (all device px)
        { type : float4, name : shape,   precision : high },
        // the moving fill: x left edge (local px), y width, z corner radius,
        // w unused
        { type : float4, name : fill,    precision : high },
        { type : float4, name : ink },   // the glass (or the rule), alpha in w
        { type : float4, name : tick },  // the centre tick, alpha in w
        { type : float4, name : bar }    // --c: this player's livery, w unused
    ],
    variables : [ uv ],
    shadingModel : unlit,
    // Fog is ours (ttp_fog.inc); every material filters Filament's variant
    // (tests/material-rules.test.js says why).
    variantFilter : [ fog ],
    blending : transparent,
    culling : none,
    depthWrite : false,
    depthCulling : false,
    // DEVICE domain: the vertex stage maps the quad's canvas pixels into the
    // DRAWING VIEW's cell itself (getMaterialGlobal3, below), so the same
    // quads draw inside each race cell's own pass on the platforms that
    // have no present pass — the separate overlay pass over the finished
    // frame was 1.2 ms of a 540-line four-player frame on the Android box,
    // a load and a store of the whole canvas for a few rounded rects.
    vertexDomain : device
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // The mesh is a unit quad; the model transform places it in CANVAS
        // pixels (bottom-left origin, like a GL viewport). getMaterialGlobal3
        // is the drawing view's rect in the same pixels — a race cell, or the
        // whole canvas for the overlay view — and this maps canvas px into
        // that view's clip space. A quad outside the cell lands outside the
        // clip volume and costs nothing; a divider that straddles two cells
        // is drawn by both, each its own half, over disjoint pixels.
        highp vec4 cell = getMaterialGlobal3();
        highp vec2 s = 2.0 / max(cell.zw, vec2(1.0));
        highp mat4 toClip = mat4(
                vec4(s.x, 0.0, 0.0, 0.0),
                vec4(0.0, s.y, 0.0, 0.0),
                vec4(0.0, 0.0, 0.0, 0.0),                // z flat at 0: never clipped
                vec4(-1.0 - cell.x * s.x, -1.0 - cell.y * s.y, 0.0, 1.0));
        // getWorldFromModelMatrix() is in Filament's RENDER world, which is
        // rebased at the camera every frame; getUserWorldFromWorldMatrix()
        // undoes that, and the quad's canvas pixels are in the user world.
        // Without it the chrome followed each cell's camera — the divider
        // wandered by the camera's own x on a phone before anyone saw it.
        material.clipSpaceTransform = toClip
                * getUserWorldFromWorldMatrix() * getWorldFromModelMatrix();
        // Carrying the local PIXEL coordinate is what lets every measurement
        // below be a pixel number straight off drawOverlay's composition.
        material.uv.xy = getPosition().xy * materialParams.size;
    }
}

fragment {
    // Signed distance to a rounded box centred on the origin. r is clamped to
    // the half-extent, which is also CSS's rule for an over-large radius: a
    // `border-radius: 999px` pill on a 34 px-tall bar resolves to 17.
    float sdBox(highp vec2 p, highp vec2 h, highp float r) {
        r = clamp(r, 0.0, min(h.x, h.y));
        highp vec2 q = abs(p) - h + r;
        return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
    }

    // Pixel coverage from a distance in pixels: a one-texel ramp across the
    // edge, which is the antialiasing the browser's rasterizer gave the DOM
    // bar. No fwidth() needed — the varying IS in pixels, so |grad d| == 1.
    float cov(highp float d) { return clamp(0.5 - d, 0.0, 1.0); }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 h = materialParams.size * 0.5;
        highp vec2 p = variable_uv.xy - h;
        highp float pad = materialParams.shape.y;
        float outer = cov(sdBox(p, h, materialParams.shape.x));

        // Premultiplied throughout, like vblend: Filament's `transparent`
        // blending works in premultiplied alpha, so a straight-alpha colour
        // would add its full value at the antialiased edges and turn every
        // curve into a hard one.
        vec4 o = vec4(materialParams.ink.rgb, 1.0) * materialParams.ink.w;

        if (pad > 0.0) {
            // The tick: centred on the bar and as tall as the fill, painted
            // UNDER it, so it shows only where the fill has moved off centre.
            highp float t = materialParams.shape.z * 0.5;
            float tick = clamp(t - abs(p.x) + 0.5, 0.0, 1.0)
                    * cov(abs(p.y) - (h.y - pad)) * materialParams.tick.w;
            o = vec4(materialParams.tick.rgb, 1.0) * tick + o * (1.0 - tick);

            // The fill: the pill that tracks raw phone tilt. Inset by `pad` on
            // every side, and drawOverlay's travel stops it `pad` short of
            // either end, so even full lock leaves glass showing past it.
            highp vec2 fh = vec2(materialParams.fill.y * 0.5, h.y - pad);
            highp vec2 fc = vec2(materialParams.fill.x + fh.x, h.y);
            float f = cov(sdBox(variable_uv.xy - fc, fh, materialParams.fill.z));
            o = vec4(materialParams.bar.rgb, 1.0) * f + o * (1.0 - f);
        }

        material.baseColor = o * outer;
    }
}
