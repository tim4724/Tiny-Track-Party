// The static receivers' sun-visibility BAKE — one pass per map at track build,
// never per frame.
//
// Every input is STATIC per track (the ESM is baked once, the sun and these
// meshes never move), so the whole ESM decode runs ONCE, here, over the light's
// own grid: this material renders the real receiver meshes through the SAME
// ortho camera the ESM bake used, evaluating the decode at each texel, and the
// runtime tap is one bilinear R8 read (see vground.mat).
//
// Baked on the light's grid, the map's uv IS shadowFromWorld's output — the
// same matrix vground's vertex stage applies — so no second transform exists to
// disagree with the ESM's.
//
// Depth state is the CALLER's: the ground's map draws one single-valued surface
// with no depth buffer, the structures' map is depth-tested so the surface
// nearest the sun wins each texel (bakeShadowMap sets it per instance).
material {
    name : TtpVvis,
    requires : [
        // (encoded ambient, NoL) — the receiver's baked vertex light; only the
        // NoL in .w is read, for the slope bias and the edge-on fade.
        custom0
    ],
    variables : [ nol ],
    shadingModel : unlit,
    // Fog is ours (ttp_fog.inc); every material filters Filament's variant
    // (tests/material-rules.test.js says why).
    variantFilter : [ fog ],
    culling : none,
    doubleSided : true,
    depthWrite : false,
    depthCulling : false,
    parameters : [
        // The five shadow parameters, by the names ttp_sunvis.inc reads —
        // bindShadowMap fills them.
        { type : sampler2d, name : shadowMap, precision : high },
        { type : mat4, name : shadowFromWorld, precision : high },
        { type : float, name : shadowTexel },
        { type : float, name : shadowK },
        { type : float, name : shadowDepthScale }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.nol = vec4(getCustom0().w, 0.0, 0.0, 0.0);
    }
}

fragment {
    #include "ttp_sunvis.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        material.emissive = vec4(
                sunVisibility(getUserWorldPosition(), variable_nol.x), 0.0, 0.0, 0.0);
    }
}
