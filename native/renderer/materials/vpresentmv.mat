// The multiview composite: the 2D-array scene layers → the split-screen cells
// on the swap chain. The Android-only sibling of vpresent.mat's present pass —
// a multiview render target is an ARRAY texture (one layer per eye), and a
// swap chain is not, so a stereo frame always ends with this resolve however
// cheap everything else got.
//
// No FXAA on purpose: this leg runs the antialias pass OFF (the switch's whole
// saving is the buffer + the read, see ttp_display_antialias), and this pass
// exists for the RESOLVE, not as a place to smuggle the filter back in. One
// textureLod per fragment; the layers are rendered at exactly the cell size, so
// the fetch is 1:1 and NEAREST.
//
// The cell grid arrives as uniforms rather than being re-derived: TtpRenderer::
// cellRect is the one authority on the fitted grid (band-clamped, centred), and
// this shader only inverts its pixel layout — bottom-left origin, row 0 on TOP.
material {
    name : TtpVpresentMv,
    parameters : [
        { type : sampler2dArray, name : scene, precision : medium },
        // fitted grid, in surface px, bottom-left origin: x0, y0, cellW, cellH
        { type : float4, name : grid, precision : high },
        // cols, rows, cellCount (layers beyond it are never shown)
        { type : float3, name : lay,  precision : high },
        // the surface size in px, to turn uv back into pixels
        { type : float2, name : surf, precision : high }
    ],
    variables : [ uv ],
    vertexDomain : device,
    shadingModel : unlit,
    culling : none,
    depthWrite : false,
    depthCulling : false
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.uv.xy = uvToRenderTargetUV(getPosition().xy * 0.5 + 0.5);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);

        highp vec2 px = variable_uv.xy * materialParams.surf;
        highp vec2 q = (px - materialParams.grid.xy) / materialParams.grid.zw;
        float col = floor(q.x);
        float rowB = floor(q.y);          // 0 at the BOTTOM row (GL pixel space)
        float rowT = materialParams.lay.y - 1.0 - rowB;   // 0 at the TOP row
        float idx = rowT * materialParams.lay.x + col;
        // Off the grid (the centring margins, the letterbox band) and any tile
        // past the cell count stay the clear colour.
        if (col < 0.0 || col >= materialParams.lay.x
                || rowB < 0.0 || rowB >= materialParams.lay.y
                || idx >= materialParams.lay.z) {
            material.emissive = vec4(0.0, 0.0, 0.0, 0.0);
            return;
        }
        highp vec2 cuv = q - vec2(col, rowB);
        material.emissive = vec4(
                textureLod(materialParams_scene, vec3(cuv, idx), 0.0).rgb, 0.0);
    }
}
