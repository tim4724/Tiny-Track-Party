// THE CAR SHADOW AS A PASS: one blended draw for every car together over the
// road's OWN deck triangles under each (TtpRenderer::placeCarShadow clips them
// into the pass's own buffers), on the same vertex-domain path, so every
// fragment is a road fragment at the road's own depth — a tyre in front wins
// the depth test, nothing floats, a crest or a loop is the road itself.
//
// THE SHAPE IS A TEXTURE LOCKED TO THE CAR, not arithmetic per fragment: the
// fitted rounded rect's ramp field (ttp/car_footprint.h, RoundedRectEval)
// baked once per car model into a tile of one atlas
// (TtpRenderer::carShadowStamp), sampled at the stamp's (u, v) in that tile.
// The (u, v) is affine in world position, so the CPU computes it per vertex
// where it clips the strips (custom1.xy, with the car's peak alpha in .z),
// and one draw carries every car. Evaluated per fragment (a divide, a
// length, two smoothsteps) the same shape cost ~1.8 ms of a 4P 720 frame on the Android box over the
// lane cells; a tap costs what the rubber tap costs. And because the texture
// rides the car's frame, nothing re-lands on a road grid frame to frame: no
// pulsing bands, no shiver.
//
// Lit as the deck lights its paint — the encoded ink times the deck's baked,
// display-encoded full light, per VERTEX (a few hundred a frame); the
// fragment fogs, applies the remap band and the display-space alpha, and
// blends premultiplied like vblend.
material {
    name : TtpVshadow,
    variables : [ { name : fog, precision : medium }, { name : inkd, precision : medium },
                  { name : suv, precision : high } ],
    vertexDomain : world,
    requires : [
        custom0, custom1
    ],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    parameters : [
        // x, y: the remap band's lo and hi (CarShadowTuning's remapLo/Hi x ao);
        // z: the cap.
        { type : float4, name : fill },
        { type : float4, name : ink },
        { type : sampler2d, name : stamp }
    ]
}

fragment {
    #include "ttp_fog.inc"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // The field, scaled to this frame's peak; the remap band on it, as
        // vroad's tap applied it; the cap against stacked shadows.
        float cs = texture(materialParams_stamp, variable_suv.xy).r * variable_inkd.w;
        float a = min(cs * smoothstep(materialParams.fill.x, materialParams.fill.y, cs),
                materialParams.fill.z);
        // The blend lands in display space, where the layer mixed the ink into
        // the deck in linear. A remap to the linear mix's display weight
        // ((1 - a)^(1/2.2)) matched the layer on paper and read too weak on the
        // TV; the stamp's own alpha is the look (2026-10-14). Premultiplied,
        // same as vblend: a straight colour at alpha 0 ADDED itself over the
        // whole cell.
        material.baseColor = vec4(ttpFogMix(variable_inkd.xyz, variable_fog.x) * a, a);
    }
}

vertex {
    #include "ttp_fog.inc"
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec3 wp = material.worldPosition.xyz;
        material.fog = vec4(ttpFogFactor(wp), 0.0, 0.0, 0.0);
        // THE DEPTH BIAS IS A SHRINK TOWARD THE EYE, not a polygon offset.
        // Every vertex moves a fixed fraction of its distance along its own
        // eye ray, so its screen position does not change and its depth lands
        // in front of the road's by that fraction — at every grazing angle,
        // on every backend, independent of the depth format. A polygon
        // offset of one constant unit did not do this: the strips are a
        // different triangulation of the road's own planes, and the rounding
        // between the two exceeds a unit, so the shadow lost the depth test
        // over most of its area on the web (a stippled remnant), and a slope
        // term grows past the car at grazing angles. 3e-4 is a millimetre at
        // three units, far over the two triangulations' disagreement and far
        // under anything a tyre bottom could show. It also keeps early depth
        // culling on, which a polygon offset turns off.
        material.worldPosition.xyz = wp + (getWorldCameraPosition() - wp) * 3e-4;
        // The stamp's (u, v) in the atlas, from the CPU (placeCarShadow):
        // affine in world position, so exact under interpolation.
        highp vec4 c1 = getCustom1();
        material.suv = vec4(c1.xy, 0.0, 0.0);
        // The ink (encoded) under the ring's full light (custom0 = the deck's
        // encoded ambient + sun, mRingLight): display space, so a multiply is
        // the whole of the shading. The car's peak alpha rides .w.
        material.inkd = vec4(materialParams.ink.xyz * getCustom0().xyz, c1.z);
    }
}
