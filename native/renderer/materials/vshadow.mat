// THE CAR SHADOW AS A PASS: one blended draw per car over the road's OWN
// deck cells under it (TtpRenderer::placeCarShadow), the same vertex buffer
// and the same vertex-domain path, so every fragment is a road fragment at
// the road's own depth — a tyre in front wins the depth test, nothing floats,
// a crest or a loop is the road itself.
//
// THE SHAPE IS A TEXTURE LOCKED TO THE CAR, not arithmetic per fragment: the
// fitted rounded rect's ramp field (ttp/car_footprint.h, RoundedRectEval)
// baked once per car model (TtpRenderer::carShadowStamp), sampled at the
// stamp's (u, v), which is affine in world position and so comes from the
// vertex stage. Evaluated per fragment (a divide, a length, two smoothsteps)
// the same shape cost ~1.8 ms of a 4P 720 frame on the Android box over the
// lane cells; a tap costs what the rubber tap costs. And because the texture
// rides the car's frame, nothing re-lands on a road grid frame to frame: no
// pulsing bands, no shiver — the two things the road-space layer could not
// stop paying its B-spline for.
//
// Lit as the deck lights its paint — the ink times the deck's baked matte
// light plus the sun term, graded — but per VERTEX (a few hundred a frame),
// so the fragment grades nothing; it fogs, applies the remap band and the
// display-space alpha, and blends premultiplied like vblend.
material {
    name : TtpVshadow,
    variables : [ fog, inkd, { name : suv, precision : high } ],
    vertexDomain : world,
    requires : [
        custom0
    ],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    parameters : [
        // The car's frame on the deck: the stamp's origin, forward and right.
        // float4, not float3: a highp vec3 here read back at the wrong scale
        // on the Vulkan box (the stamp's frame came out at a tenth of itself).
        { type : float4, name : origin, precision : high },
        { type : float4, name : fwd, precision : high },
        { type : float4, name : right, precision : high },
        // x: 1 / halfR, y: 1 / halfF, z: the stamp's peak alpha, w: the cap.
        { type : float4, name : extent },
        // x, y: the remap band's lo and hi (CarShadowTuning's remapLo/Hi x ao).
        { type : float4, name : fill },
        { type : float4, name : ink },
        { type : sampler2d, name : stamp },
        { type : sampler2d, name : gradeLut }
    ]
}

fragment {
    #include "ttp_fog.inc"
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // The field, scaled to this frame's peak; the remap band on it, as
        // vroad's tap applied it; the cap against stacked shadows.
        float cs = texture(materialParams_stamp, variable_suv.xy).r * materialParams.extent.z;
        float a = min(cs * smoothstep(materialParams.fill.x, materialParams.fill.y, cs),
                materialParams.extent.w);
        // The blend lands AFTER the grade, in display space, where the layer
        // mixed the ink into the deck BEFORE it; a near-black ink at the same
        // alpha reads much darker here. (1 - a)^(1/2.2) is the display-space
        // weight that matches the linear mix; the cubic is its series.
        a = a * (0.4545 + a * (0.1240 + a * 0.0639));
        // Grade (done at the vertex), then premultiply, same as vblend: a
        // straight colour at alpha 0 ADDED itself over the whole cell.
        material.baseColor = vec4(ttpFogMix(variable_inkd.xyz, variable_fog.x) * a, a);
    }
}

vertex {
    #include "ttp_shade.inc"
    #include "ttp_fog.inc"
    #include "ttp_grade.inc"
    void materialVertex(inout MaterialVertexInputs material) {
        vec4 c0 = getCustom0();
        highp vec3 wp = material.worldPosition.xyz;
        material.fog = vec4(ttpFogFactor(wp), 0.0, 0.0, 0.0);
        // The stamp's (u, v) over its quad: right across, forward along —
        // affine in world position, so exact under interpolation.
        highp vec3 d = wp - materialParams.origin.xyz;
        material.suv = vec4(dot(d, materialParams.right.xyz) * materialParams.extent.x * 0.5 + 0.5,
                dot(d, materialParams.fwd.xyz) * materialParams.extent.y * 0.5 + 0.5, 0.0, 0.0);
        vec3 lit = materialParams.ink.xyz * (c0.xyz + ttpMatteSunTerm(c0.w));
        material.inkd = vec4(ttpGrade(lit), 0.0);
    }
}
