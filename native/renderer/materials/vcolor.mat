material {
    name : TtpVcolor,
    // The fog's own term, colour × luminance × fog factor (ttp_fog.inc), with
    // (1 - fog) already multiplied into the vertex colour: the fragment adds
    // and nothing else. Display colour, so mediump.
    variables : [ { name : fog, precision : medium } ],
    requires : [
        color
    ],
    shadingModel : unlit,
    // Fog is ours (ttp_fog.inc); every material filters Filament's variant
    // (tests/material-rules.test.js says why).
    variantFilter : [ fog ],
    culling : none
}

fragment {
    // The vertex colour is the displayed colour (packShown, TtpRendererImpl.h),
    // fogged per vertex (the vertex block).
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = getColor();
        material.baseColor.rgb += variable_fog.xyz;
    }
}

vertex {
    #include "ttp_fog.inc"

    // The fog is the only thing this stage exists for: per vertex, so the
    // fragment pays an add instead of a sqrt and an exp. (1 - a) folds into
    // the colour here and F a rides the varying (ttp_fog.inc, ttpFogTerm).
    void materialVertex(inout MaterialVertexInputs material) {
        float a = ttpFogFactor(material.worldPosition.xyz);
        material.color.rgb *= 1.0 - a;
        material.fog = vec4(ttpFogTerm(a), 0.0);
    }
}
