material {
    name : TtpVcolor,
    requires : [
        color
    ],
    shadingModel : unlit,
    culling : none
}

fragment {
    #include "ttp_grade.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = getColor();
        material.baseColor.rgb = ttpGrade(material.baseColor.rgb);
    }
}
