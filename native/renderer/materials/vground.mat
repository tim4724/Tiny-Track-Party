// Textured matte ground — the biome's floor canvas.
//
// The JS ground is a plane wearing a tiled 256² canvas texture (lawn mowing
// stripes, sand grit, red-rock strata, snow drift, wood planks) on a Lambert
// material with a white tint: the texture carries ALL of the colour. The port
// approximated it with vertical vertex-colour bands, which is right for a
// stripe pattern and wrong for anything with structure in both axes — the
// playroom's wood floor lost its plank seams, end joints and knots and read as
// flat diagonal banding.
//
// So: same texture, generated pixel-for-pixel in C++ and sampled here, on the
// same hand-written Lambert as vlit (see that file for why the lighting is
// spelled out instead of using Filament's `lit` model). flipUV is off so the
// C++ UVs (world XZ / tile) map straight through.
//
// The ground DOES catch the sun's baked map. The thing the original opt-out was
// protecting against is a CAR's ground blob detaching onto the lawn far below
// its deck — but that blob is a conformed decal (vdecal), a different mechanism
// entirely. The baked map holds only the static casters, and only the ones high
// enough to be worth casting: setMeshShadowsAbove keeps road below
// groundY + 1.8 out of it, so a deck lying on the floor cannot shadow the floor
// it is lying on. What is left is exactly what you want to see — an elevated
// track laying its shape on the ground underneath.
material {
    name : TtpVground,
    requires : [
        uv0,
        // the world normal the Lambert term needs (getWorldGeometricNormalVector)
        tangents
    ],
    shadingModel : unlit,
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : albedo },
        // The frozen sun map, shared with vlit — same space, same compare.
        { type : sampler2d, name : shadowMap, precision : high },
        { type : mat4, name : shadowFromWorld, precision : high },
        { type : float, name : shadowTexel },
        { type : float, name : shadowK },
        // 1 / ortho depth range: turns a world-unit bias into normalised depth.
        { type : float, name : shadowDepthScale }
    ]
}

fragment {
    // Identical to vlit's — see that file for why the depth is reversed [0,1]
    // and why both halves of the convention were measured rather than assumed.
    float sunVisibility(highp vec3 wp, highp vec3 n, float NoL) {
        if (materialParams.shadowTexel <= 0.0) return 1.0;
        // No normal offset: ESM's bias is inherent (equal depths give exp(0) = 1),
        // and nudging the sample along the normal would only detach the shadow
        // from whatever cast it.
        highp vec4 sp = materialParams.shadowFromWorld * vec4(wp, 1.0);
        highp vec3 uv = sp.xyz / sp.w;
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0
                || uv.z <= 0.0 || uv.z >= 1.0) return 1.0;
        // ONE bilinear tap. vesm.mat pre-blurred exp(-k·d) at bake time, so the
        // penumbra is already in the texel — no PCF kernel, and the map can be
        // smaller than a filtered depth map would have to be. Equal depths give
        // exp(0) = 1, so the acne bias is inherent and needs no constant.
        // SLOPE-SCALED BIAS. ESM's bias is only inherent for a receiver whose
        // depth is constant across a shadow texel. A surface seen edge-on by the
        // sun is the opposite case: skysnake's loop wall sits ~7 degrees off the
        // light, so its own depth spreads ~0.46 world units inside ONE texel and
        // it shadows itself in a comb of dark tongues. Scale the guard by the
        // grazing angle so flat ground pays nothing for it.
        float slope = clamp(sqrt(max(0.0, 1.0 - NoL * NoL)) / max(NoL, 0.12), 1.0, 12.0);
        float biasW = materialParams.shadowTexel * 2.0 * slope; // world units
        // SUPERSAMPLE THE VISIBILITY OVER THE PIXEL'S FOOTPRINT.
        //
        // The map is MINIFIED nearly everywhere it covers — one screen pixel
        // spans several shadow texels — so a single tap undersamples it and the
        // edge aliases into stairs. How badly depends on the receiver's slope,
        // its distance and where it lands in the map, which is why it varied so
        // strongly from one part of a loop to another.
        //
        // Pre-filtering the map cannot fix this: exp(k*z) * occ is CLAMPED, and
        // the clamp re-sharpens whatever the bake-time blur smoothed. That is
        // also why widening vesm's kernel changed nothing. The function that
        // needs filtering is the visibility itself, so evaluate it four times
        // across the footprint and average — a rotated 2x2, which beats an axis
        // aligned one on the near-horizontal and near-vertical edges this scene
        // is full of.
        highp vec2 fw = min(fwidth(uv.xy), vec2(8.0 / 2048.0)); // cap runaway slopes
        highp float bias = materialParams.shadowK
                * (uv.z + biasW * materialParams.shadowDepthScale);
        highp vec2 o1 = vec2( fw.x * 0.375, fw.y * 0.125);
        highp vec2 o2 = vec2(-fw.x * 0.125, fw.y * 0.375);
        float vis = 0.25 * (
                  clamp(exp(bias) * texture(materialParams_shadowMap, uv.xy + o1).r, 0.0, 1.0)
                + clamp(exp(bias) * texture(materialParams_shadowMap, uv.xy - o1).r, 0.0, 1.0)
                + clamp(exp(bias) * texture(materialParams_shadowMap, uv.xy + o2).r, 0.0, 1.0)
                + clamp(exp(bias) * texture(materialParams_shadowMap, uv.xy - o2).r, 0.0, 1.0));
        // ...and fade the whole test out as the surface turns edge-on to the
        // sun. The bias above scales with 1/NoL, but the depth spread inside a
        // texel goes to INFINITY at true grazing, so no finite bias closes the
        // last few degrees. skysnake's loop is the case: a vertical tube with a
        // RAISED KERB along each rim, lit from ~7 degrees off its own surface,
        // so the kerb scallops the wall below it with a comb of tongues. They
        // are arguably real, and they look like noise.
        //
        // A surface that edge-on receives almost no sun anyway — the term is
        // multiplied by NoL — so a shadow there carries no information and only
        // its artefacts show. Trust the lookup where the light actually lands
        // (NoL 0.40 is 24 degrees above grazing; a road deck under an overpass
        // sits at 0.98 and is untouched) and let it go where it does not.
        return mix(1.0, vis, smoothstep(0.05, 0.40, NoL));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);

        highp vec3 n = getWorldGeometricNormalVector();
        vec3 base = texture(materialParams_albedo, getUV0()).rgb;

        vec3 ambient = max(frameUniforms.iblSH[0]
                + frameUniforms.iblSH[1] * n.y
                + frameUniforms.iblSH[2] * n.z
                + frameUniforms.iblSH[3] * n.x, vec3(0.0)) * frameUniforms.iblLuminance;

        float NoL = saturate(dot(n, frameUniforms.lightDirection));
        float visibility = sunVisibility(getUserWorldPosition(), n, NoL);
        vec3 sun = frameUniforms.lightColorIntensity.rgb
                * (frameUniforms.lightColorIntensity.w * NoL * visibility * (1.0 / PI));

        material.emissive = vec4(base * (ambient + sun), 0.0);
    }
}
