// THE STATIC-RECEIVER material: the ground, the structures (pillars, poles,
// loop shafts) and the berms. One rule for all of them (ttp_shade.inc): a
// static surface's light is vertex data, and its sun shadow is one tap into a
// BAKED visibility map. The file keeps the ground's name only so the three
// shells' material lists did not have to move.
//
// LIGHT. custom0 is the ambient term and custom1 the ambient-plus-sun term,
// both DISPLAY-ENCODED, filled once per track by TtpRenderer::bakeVertexLight
// — the sun and these meshes never move, so evaluating the SH and N·L per
// vertex per frame bought nothing, and the encode is the CPU's for the same
// reason. The fragment mixes the two through the visibility tap, in display
// space (TtpRendererImpl.h, "authored in display space", says what that
// costs). Interpolating light across the ground's 20 u mesh step is sound
// because it varies over metres; the shadow's 0.6 u edge does not, which is
// why it is a texture.
//
// SHADOW. One bilinear R8 tap of a map vvis.mat baked over the LIGHT's own grid,
// so the map's uv IS shadowFromWorld's output. That transform is affine and
// exact under interpolation, so it stays a per-vertex mat4 rather than a baked
// attribute (the matrix only exists once the bake has run). The ground and the
// structures each get their own map — see bakeShadowMap for why one cannot hold
// both. Outside the light's frustum the bake's border texels are lit and
// CLAMP_TO_EDGE extends them.
//
// COLOUR is albedo × vertex colour. The ground carries its biome canvas (the
// tiled texture, generated pixel-for-pixel in C++) on white vertices; the
// structures and berms carry their colour in the vertex and bind the 1×1 white
// as albedo with zero uvs. flipUV is off so the C++ UVs (world XZ / tile) map
// straight through.
//
// ROCK WHERE THE LAND IS STEEP, decided per FACET, so its edge is the mesh's
// own and as crisp as the rock set pieces' cut faces: the ground's vertex
// alpha is 0 on every corner of a rock triangle and 1 on every other, exactly
// (TtpRenderer::gateRock decides, and splits a corner a rock facet shares),
// so the branch covers whole facets. Never an interpolated weight or a
// noise: either blurs the edge into blobs. The structures and berms keep 1,
// so most fragments skip the branch. Rock is strata of rockA and rockB, each topped
// by a bench of rockL rockL.a of a stratum thick, stacked by height over the
// plain (strata.w) on a square root, so a low face shows a few bands and a
// tall one a few thick ones rather than a contour map, bent by a broad sine
// lattice (strata.y u of it) and filtered over the pixel's height span so no
// band edge shimmers in a small cell; a biome with strata.x 0 has none, only
// rockA. Each facet is shaded by its own flat normal (the world position's
// screen derivatives; facet: the sun times
// a gain, and an offset), so a rock face reads cut, not smooth. World XZ is
// uv0 times the canvas tile (rockA.a, kGroundTile), world Y rides suv.w.
material {
    name : TtpVground,
    // Every receiver (ground, structures, berms) is built in world units on an
    // identity transform — vroad.mat says why `world` is worth it.
    vertexDomain : world,
    variables : [
        // fog.yzw = the baked ambient and sun.xyz = ambient + sun, both
        // encoded and both ALREADY SCALED by (1 - fog) per vertex, with the
        // fog's own term riding fog.x / sun.w / suv.z (ttp_fog.inc has the
        // fold): display colour, so mediump. suv.xy = the visibility-map
        // uv, whole in ONE varying so its tap is a bare .xy read (vroad's
        // rule); suv.w the world height the rock's strata stack by. highp: a half-precision uv steps by ~0.0005 near 1.0 — a
        // quarter-texel of the 512-wide bake, enough to shimmer a contrasty
        // shadow edge as the camera moves.
        { name : fog, precision : medium },
        { name : sun, precision : medium },
        { name : suv, precision : high }
    ],
    requires : [
        color,
        uv0,
        // the two encoded light terms — see above
        custom0,
        custom1
    ],
    shadingModel : unlit,
    // Fog is ours (ttp_fog.inc); every material filters Filament's variant
    // (tests/material-rules.test.js says why).
    variantFilter : [ fog ],
    culling : none,
    doubleSided : true,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : albedo },
        // The baked visibility map (vvis.mat) and what puts a world position
        // in its [0,1] space — the same matrix the ESM bake used, so the two
        // cannot disagree. A track with no bake binds 1x1 white, which reads
        // as fully lit with no branch.
        { type : sampler2d, name : visMap },
        { type : mat4, name : shadowFromWorld, precision : high },
        // The rock (above): display-encoded colours (float4 on purpose: a
        // float3 parameter read wrong on the box's Vulkan; rockA.a carries
        // the canvas tile, rockB.a is spare), its banding and its facets.
        { type : float4, name : rockA },
        { type : float4, name : rockB },
        { type : float4, name : rockL },
        { type : float4, name : strata, precision : high },
        { type : float4, name : facet }
    ]
}

fragment {
    // The albedo tap, in a helper ON PURPOSE: matc adds filament_lodBias to
    // every texture() written directly in material(), and a biased read may not
    // be a plain varying read (vroad's skidInk). The bias is always 0 here.
    vec3 albedoAt(highp vec2 uv) {
        return texture(materialParams_albedo, uv).rgb;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // textureLod, matching the renderer-wide rule: the map is one level,
        // bound with a non-mipmap filter, so LOD 0 is what an implicit sample
        // would pick — and this call site stays legal if a branch ever grows
        // around it.
        float vis = textureLod(materialParams_visMap, variable_suv.xy, 0.0).r;
        // Albedo (the canvas's bytes times the vertex tint, both display-
        // encoded) times the light, its two halves mixed through the
        // visibility here, in display space.
        vec4 tint = getColor();
        vec3 base = albedoAt(getUV0()) * tint.rgb;
        // The world position and its screen derivatives, taken out here: a
        // derivative inside a branch a quad splits is undefined.
        highp vec3 wp = vec3(getUV0() * materialParams.rockA.a, variable_suv.w).xzy;
        highp vec3 dpx = dFdx(wp);
        highp vec3 dpy = dFdy(wp);
        if (tint.a < 0.5) {
            highp vec3 fn = normalize(cross(dpx, dpy));
            fn = fn.y < 0.0 ? -fn : fn;
            vec3 rc = materialParams.rockA.rgb;
            if (materialParams.strata.x > 0.0) {
                // Two crossed sines of ~30 u bend the strata.
                float n1 = sin(wp.x * 0.21 + wp.z * 0.17) + sin(wp.z * 0.23 - wp.x * 0.19);
                highp float h = max(wp.y - materialParams.strata.w + materialParams.strata.y * n1, 0.0) + 1.0;
                highp float t = materialParams.strata.x * sqrt(h);
                // Two strata (A then B, each under its bench) per 2 of t,
                // unevenly thick, every edge filtered over the pixel's
                // height span (dx/dh is strata.x / (4 sqrt h), with room
                // for the unevenness).
                highp float x = fract(0.5 * (t + 0.12 * sin(3.7 * t)));
                float k = sqrt(h) / max(0.4 * materialParams.strata.x * (abs(dpx.y) + abs(dpy.y)), 1e-4);
                float w = materialParams.rockL.a;
                rc = mix(materialParams.rockL.rgb, rc, clamp(x * k + 0.5, 0.0, 1.0));
                rc = mix(rc, materialParams.rockL.rgb, clamp((x - 0.5 + w) * k + 0.5, 0.0, 1.0));
                rc = mix(rc, materialParams.rockB.rgb, clamp((x - 0.5) * k + 0.5, 0.0, 1.0));
                rc = mix(rc, materialParams.rockL.rgb, clamp((x - 1.0 + w) * k + 0.5, 0.0, 1.0));
                rc = mix(rc, materialParams.rockA.rgb, clamp((x - 1.0) * k + 0.5, 0.0, 1.0));
            }
            base = rc * (dot(fn, materialParams.facet.xyz) + materialParams.facet.w);
        }
        // The light terms arrive scaled by (1 - fog) and the fog's own term
        // rides the spare components (the vertex block), so the composite is
        // one mix and one add.
        material.baseColor = vec4(base * mix(variable_fog.yzw, variable_sun.xyz, vis)
                + vec3(variable_fog.x, variable_sun.w, variable_suv.z), 1.0);
    }
}

vertex {
    #include "ttp_fog.inc"

    void materialVertex(inout MaterialVertexInputs material) {
        // World IS user world: TtpRenderer::init turns Filament's camera-at-
        // origin shift off, so getUserWorldFromWorldMatrix() is the identity
        // and the vertex is spared that mat4 multiply.
        highp vec3 uwp = material.worldPosition.xyz;
        // uvToRenderTargetUV is mandatory: the map is an offscreen target and
        // Metal-family backends store it flipped (ttp_sunvis.inc has the story).
        highp vec2 suv = uvToRenderTargetUV(
                (materialParams.shadowFromWorld * vec4(uwp, 1.0)).xy);
        // The fog folded into the light halves, F × a over the spare
        // components (ttp_fog.inc, ttpFogTerm).
        float a = ttpFogFactor(material.worldPosition.xyz);
        float k = 1.0 - a;
        vec3 F = ttpFogTerm(a);
        material.fog = vec4(F.r, getCustom0().xyz * k);
        material.sun = vec4(getCustom1().xyz * k, F.g);
        material.suv = vec4(suv, F.b, uwp.y);
    }
}
