// The road deck: vlit's matte light, BAKED per vertex at track build
// (TtpRenderer::fillRoadLight), plus TRACK-SPACE coordinates and the
// flat decals that used to be laid over the road as separate geometry.
//
// WHY THE ROAD NEEDS ITS OWN MATERIAL. Every deck decal — the boost aura, a car's
// contact shadow, a banana's blob, and in time the pads, launch strips and oil
// slicks — used to be a second mesh floating a hair above the deck. That hair is
// unavoidable for a separate mesh: the road is a chord approximation of a curved
// surface and so is the decal, at a different vertex spacing, so the two do not
// coincide and whichever sags further loses. Shading the decal INTO the road
// removes the question rather than tuning it: the decal fragment IS a road
// fragment, at the road's own depth. No lift, no sag, no polygon offset, and no
// render-order to get wrong.
//
// vlit could not simply grow a uv0 channel: buildMesh hands vlit's default
// instance to EVERY mesh that carries normals (hills, structures, berms, scenery,
// props), so requiring uv0 there would mean a UV buffer on all of them.
//
// THE COORDINATES ARE (s, lat), written by buildRoadMesh into uv0, both in WORLD
// units: arclength along the centreline, and lateral offset from it. Nothing is
// normalised — v was lat/half at first so the deck could be masked with |v| <= 1,
// and that needed two independently-computed half-widths to agree. See the mask
// note in material() for how that failed.
//
// Track space is also why this handles the geometry the old approach could not:
// a fragment carries its OWN s, so a loop — where one (x, z) has two different
// arclengths stacked above each other — is unambiguous, and a decal follows every
// crest, dip and bank without anything being conformed to anything.
material {
    name : TtpVroad,
    // The per-vertex fog factor (ttp_fog.inc); .yzw unused.
    variables : [ fog ],
    requires : [
        color,
        // (s, lat) in world units — see above
        uv0,
        // The matte light — ambient + sun + the baked ESM's visibility — BAKED
        // per road vertex at track build (TtpRenderer::fillRoadLight, the CPU
        // twin of ttpMatteLight): every input is static per track, so
        // re-evaluating it per vertex PER FRAME bought nothing. Baking it also
        // retired `tangents` — nothing in either stage reads the normal now,
        // which drops a 16-byte qtangent fetch per vertex on the scene's
        // biggest mesh (buildMesh feeds CUSTOM0 instead of TANGENTS when this
        // attribute is required).
        custom0
    ],
    shadingModel : unlit,
    culling : none,
    doubleSided : true,
    // uv0 IS NOT A TEXTURE COORDINATE HERE, it is track space (s, lat), and
    // Filament flips V by default for the usual image-origin reason. Left on,
    // getUV0().y comes back as 1 - lat, which is not obviously wrong at a glance
    // and quietly puts every decal in the wrong place: the match lands where
    // 1 - lat equals the decal's lat, i.e. over by the far kerb. Off.
    flipUV : false,
    parameters : [
        // (No shadow parameters here any more: the ESM decode this material
        // shared with vlit runs ONCE per track now, on the CPU, into the
        // custom0 vertex light — see fillRoadLight. That also unbinds a
        // sampler from every road chunk's draw, the same per-draw descriptor
        // cost vlitns.mat exists to avoid.)

        // — deck decals: ONE typed uniform list (profiles) + ONE texture tap
        //   (the car shadows) —
        //
        // A dynamically-indexed uniform array costs whether or not the loop
        // runs, and it costs by DECLARED SIZE: measured on a PowerVR GE9215
        // over a frozen single-player race at 1280x720, one mixed list of 32
        // entries carrying all seven arrays (3584 bytes) put the frame at
        // 25.9 ms; the same seven arrays at 8 entries put it at 17.6, and at
        // 16 at 18.9. And under a REAL pack the ITERATIONS dominate too: the
        // 2026-08-18 spectate-7 ablation put the decal channel at 4-6 ms of a
        // 22.6 ms 720p frame, almost all of it the 8-car masked loop, after
        // every arithmetic-level cut inside that loop measured zero.
        //
        // So the car shadows left the uniform path entirely: they are now a
        // per-frame CPU-rasterized TRACK-SPACE R8 layer (the rubber layer's
        // exact idiom — TtpRenderer::rasterCarShadowStamp) and this material
        // pays ONE bilinear tap for all eight, at the uv the rubber tap
        // already computes. What remains a uniform list is the PROFILE kind:
        // a shape the shader evaluates (rect/ellipse, a two-segment falloff,
        // an optional chevron grid), three vec4s per entry.
        //
        // THE CAP IS PER CHUNK, and a chunk is tens of metres of deck. Eight
        // profile is item-box shadows, oil slicks and boost auras near one
        // chunk; buildStatics orders them so an overflow drops decoration
        // rather than a marker. Raising it is measurable in the frame — the
        // spectate-7 arm that raised profile to 16 with nothing else changed
        // cost +1.1 ms p50. TtpRenderer::kMaxProfileDeckDecals must agree
        // with the [8]s below; tests/road-decal-caps.test.js holds them to it.

        // How many NEAR-car masked entries are live (the hybrid shadow LOD:
        // cars near an active camera keep the true baked silhouette; far cars
        // ride the carShadow texture tap below). Zero disables the loop.
        // FOUR is the whole budget, spent round-robin over the active views
        // (TtpRenderer.h's kMaxMaskedDeckDecals): solo dresses its four
        // nearest, a four-way split dresses each player's own car. Eight was
        // measured at ~5 ms on the 4-player frame — read that comment before
        // raising this.
        { type : int, name : maskCount },
        // How many profile entries are live. Zero makes the loop free, which
        // is what the ablation switch uses.
        { type : int, name : profCount },
        // Lap length, for the wrap: s is periodic, so a decal near the lap line
        // must still reach fragments on the other side of it.
        // PRECISION IS LOAD-BEARING on every decal parameter that carries
        // world units. A default-precision uniform is mediump, and matc's
        // Metal backend takes mediump at its word: the fp32 in the buffer is
        // ROUNDED THROUGH half ON LOAD. At an arclength of 500 an fp16 step
        // is 0.5 of a unit — the car shadow's world anchor quantized by half
        // a car length, which read as no shadow at all with flickering
        // garbage at the quantization crossings. Desktop GL promotes mediump
        // to fp32, which is why the web never showed it.
        { type : float, name : trackLength, precision : high },
        // 1/trackLength, and the arclength this chunk is centred on. Together
        // they take the lap wrap OUT of the per-decal loop: the fragment folds
        // its own arclength into the chunk's local frame ONCE, and each decal is
        // then a plain subtract. The wrap was a divide and a floor per decal per
        // fragment, which is the single most expensive thing that loop did.
        { type : float, name : invTrackLength, precision : high },
        { type : float, name : chunkMid, precision : high },
        // ONE BOUNDING BOX FOR THE PROFILE LIST, in the chunk-local s frame:
        // the union of that list's own reject windows, as (sMin, sMax, latMin,
        // latMax). A pure early-out — a fragment outside it would have
        // rejected each entry in turn — and it is here because the decals on a
        // chunk CLUSTER while the chunk is tens of metres of deck, so without
        // it the road's biggest, nearest fragments each pay N rejects to draw
        // nothing. (The car shadows carried a second box while they were a
        // uniform list; as a texture tap they need none.)
        //
        // Written by uploadDeckDecals beside the count; a list with no entries
        // leaves its box collapsed, which the count > 0 guard already covers.
        { type : float4, name : profBounds, precision : high },
        { type : float4, name : maskBounds, precision : high },

        // PROFILE stamps — statics (item-box shadows, oil slicks) and boost
        // auras. In track space:
        //   xy = centre (s, lat), zw = half-extents — ALL world units, matching
        // uv0 exactly, EXCEPT that x arrives relative to this chunk's centre
        // (see chunkMid) so the loop needs no per-decal lap wrap.
        { type : float4[8], name : profRect, precision : high },
        //   rgb = colour, a = peak alpha
        { type : float4[8], name : profColor },
        //   x = inner radius fraction held at full alpha, beyond which it
        //       feathers to nothing at 1.0 (the boost aura's 0.72 profile)
        //   y = SHAPE: 0 rectangle, 1 ellipse
        //   z = alpha at the inner knee (the profile is two straight segments,
        //       1 -> knee across 0..inner, then knee -> 0 out to the rim)
        //   w = CHEVRON grid — see paintShape below. No decal packs one today
        //       (the pads that did are paint now); the field is here because
        //       paintStamp reads one layout for both channels.
        { type : float4[8], name : profShape },

        // — the car shadows: ONE tap of a per-frame CPU-rasterized layer —
        //
        // The eight contact shadows used to be a MASKED uniform list here (a
        // baked silhouette through a rigid world-plane projection, five vec4s
        // per entry and a per-fragment reject loop). Under a real pack that
        // loop was the single biggest item in the 720p frame (~5 ms on the
        // spectate-7 view), and every arithmetic-level cut inside it measured
        // zero on the reference GPU — only structure moves it. So the stamps
        // moved to the CPU: TtpRenderer rasterizes each car's pre-blurred
        // silhouette as a WARPED QUAD into a small track-space R8 texture
        // every frame (deckFoot projects the stamp's corners — the same
        // probes the old cull window already paid for), and this material
        // pays one bilinear tap at the rubber tap's own uv. The layer is
        // TRANSIENT (erased and re-laid per frame) and PING-PONGED so the
        // upload never lands on the texture the driver is reading — see
        // TtpRenderer::uploadCarShadow.
        //
        // The curvilinear objection that created the masked path — painting
        // in (s, lat) bends the silhouette around corners, and uv0's
        // per-triangle kinks ripple through a SHARP edge — is answered by
        // structure, not ignored: the silhouette is pre-blurred, the layer is
        // coarse (a texel is ~0.1-0.2 u), and the warp lives INSIDE one stamp
        // (three deckFoot-projected slices), so the residual bending error is
        // second-order and sub-texel against the penumbra. The old shimmer
        // was an edge phenomenon and the edge is gone.
        //
        // rgb = the blob ink, in linear (kCarBlobInk — one colour for every
        // car shadow). w = the ENABLE and the CAP on summed coverage: 0 while
        // no layer exists (no track, torn down, or the ablation arm), else
        // the darkest two stacked shadows may go (the mix-of-mixes the old
        // loop produced for two overlapped stamps).
        // MASKED stamps — the NEAR cars' contact shadows, whose shape is the
        // baked silhouette. FOUR, not FIELD_SIZE: only cars within the shadow
        // LOD's near band of some active camera enter this list (renderCars),
        // the rest ride the carShadow texture — near is where the silhouette's
        // car-shape reads, and where the texture layer's ~8 texels/u cannot.
        // Half the old declared bytes; the declared-size law (re-proven
        // 2026-08-18: profile 8->16 alone cost +1.1 ms) is why this is 4 and
        // why the far path adds no arrays at all.
        //   xy = centre (s, lat); zw = the MEASURED track-space reaches (the
        //        one-vec4 reject read — see the fold comment in Decals.cpp)
        { type : float4[4], name : maskRect, precision : high },
        //   maskWPos.w   = the decalMask LAYER holding this car's silhouette
        //   maskWFwd.w   = the stamp's peak alpha (deepened by wheel load,
        //                  faded by the LOD crossfade)
        //   maskWRight.w = unused
        // Axes premultiplied by their reciprocal stamp halves: two dots, no
        // divides (the invSkidLatSpan trade).
        { type : float4[4], name : maskWPos, precision : high },
        { type : float4[4], name : maskWFwd, precision : high },
        { type : float4[4], name : maskWRight, precision : high },
        { type : float4, name : maskInk },
        // One 2D-array texture, one silhouette per layer: 0..7 the cars in
        // slot order, 8 the monster rig, 9 the generic superellipse. Baked
        // and pre-blurred by bakeSilhouette. RGBA8, coverage in ALPHA — R8
        // was tried (a quarter of the tap bytes) and the TRANSLUCENT bake
        // pass into an R8 array layer renders ZERO coverage on the PowerVR
        // driver: every silhouette sampled as nothing while the bake logged
        // success. The generic layer (an upload, not a bake) still worked,
        // which is what made the failure read as "shadows became ovals".
        { type : sampler2dArray, name : decalMask },
        // The layer: u = s / trackLength (REPEAT carries the lap wrap),
        // v = lat across ±skidLatHalf (CLAMP; the outer rows stay empty, so
        // kerbs' and underside's out-of-band v reads zero) — the rubber
        // layer's exact mapping, so the tap reuses its uv. The channel is
        // silhouette coverage × the stamp's peak alpha, folded at raster
        // time. Single level, LINEAR — the masked loop sampled its
        // silhouette at LOD 0 with no mips too, so minification behaves as
        // it did.
        { type : sampler2d, name : carShadow },

        // — the paint channel: the deck's OWN surface (repairs, boost pads) —
        // Identical entry layout to the decal arrays above and painted by the
        // same function; the ONLY difference is which side of the rubber tap it
        // composites on (buildDeckPaint has the why). Static per track, so the
        // renderer writes these once at build, per chunk, in the same
        // chunk-local s frame as profRect.
        { type : int, name : paintCount },
        { type : float4[8], name : paintRect, precision : high },
        { type : float4[8], name : paintColor },
        //   xyz as profShape; w = CHEVRON grid, packed as cols*10 + rows (cols
        //       ACROSS the lane, rows ALONG travel). 0 for a plain stamp;
        //       anything else overlays that grid in cream, which is what makes a
        //       boost pad or launch strip expressible without a texture: a
        //       chevron is two line segments and a distance to a segment is four
        //       instructions.
        { type : float4[8], name : paintShape },

        // — the rubber layer —
        // Skid marks accumulated in TRACK SPACE: an R8 texture the renderer
        // stamps trail segments into (vskid.mat), mapped u = s / trackLength
        // (REPEAT carries the lap wrap), v = lat across ±skidLatHalf. The
        // channel is the mark's ALPHA already — strength and the old pool's
        // SKID_MAX_OPACITY are folded in at stamp time — and it is PERMANENT
        // until the race-restart wipe: no decay pass exists, on purpose.
        { type : sampler2d, name : skidLayer },
        // Half the lat span the texture covers. 0 disables the tap entirely,
        // which is the no-track / torn-down state.
        { type : float, name : skidLatHalf },
        // 0.5 / skidLatHalf, premultiplied C++-side: the v mapping is then a
        // MAD instead of a per-fragment divide, which rides the narrow SFU
        // pipe this GPU has fewest of. Kept beside skidLatHalf by the two
        // writers (bindSkidLayer and the debug restore).
        { type : float, name : invSkidLatSpan },
        // rgb = SKID_COLOR in linear (srgbToLinear stays C++-side, one source),
        // a = the cap on summed ink, so crossing trails darken but a donut spot
        // cannot go pure black.
        { type : float4, name : skidColor },
        { type : sampler2d, name : gradeLut }
    ]
}

fragment {
    #include "ttp_grade.inc"
    #include "ttp_fog.inc"

    // Distance from p to the segment ab. Four instructions, and it is what lets
    // a boost pad's chevrons be drawn without a texture: the art the mesh used to
    // stroke is two segments per chevron, and the shader can measure them.
    float segDist(vec2 p, vec2 a, vec2 b) {
        vec2 pa = p - a, ba = b - a;
        float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
        return length(pa - ba * h);
    }

    // ONE stamp — a profile fill plus its optional chevron grid — given the
    // fragment's offset (ds, dl) from the entry's centre in world units. Shared
    // by BOTH channels on purpose: paint and decals differ only in which side of
    // the rubber tap they composite on, so a boost pad must not look different
    // for having changed sides. Returns `base` unchanged outside the shape.
    vec3 paintStamp(vec3 base, highp vec4 r, vec4 col, vec4 shape,
            highp float ds, float dl) {
        vec2 q = vec2(ds / r.z, dl / r.w);
        bool ell = shape.y > 0.5;
        float d = ell ? length(q) : max(abs(q.x), abs(q.y));
        if (d >= 1.0) return base;
        // Two straight segments: 1 -> knee across 0..inner, then knee -> 0
        // out to the rim. That is the profile the meshes baked into their
        // vertex alpha, reproduced exactly rather than approximated.
        float inner = shape.x, knee = shape.z;
        float prof = d <= inner
                ? mix(1.0, knee, inner > 0.0 ? d / inner : 0.0)
                : knee * (1.0 - (d - inner) / max(1.0 - inner, 1e-4));
        base = mix(base, col.rgb, clamp(col.a * prof, 0.0, 1.0));

        // CHEVRONS, laid out in the entry's normalised frame and MEASURED in
        // world units: cols ACROSS the lane and rows ALONG travel, packed as
        // cols*10 + rows. That is what makes a boost pad or a launch strip
        // expressible without a texture — a chevron is two line segments and
        // a distance to a segment is four instructions. The counts belong to
        // buildDeckPaint; the caps below are 4 rows and 6 cols, and packing
        // more silently draws fewer.
        int packed = int(shape.w + 0.5);
        int cols = packed / 10, rows = packed - cols * 10;
        if (rows > 0) {
            // A MARGIN PLUS A PACKED RUN, not one chevron per grid cell.
            // Cell centres put more air BETWEEN the marks than AROUND them:
            // the disc's three sat two of their own depths apart with the
            // rearmost running its wing tips past the rim, and the strip's
            // outer columns ran off the paint. Here the gap is a fraction of
            // a mark's own size and the margin is whatever is left of the
            // box, which with these numbers leaves the margin comfortably
            // the larger (0.14 against a 0.083 gap across the strip).
            //
            // THE STROKE IS A WORLD WIDTH, which is why the distance below is
            // taken in world units (ds, dl) rather than in q. The normalised
            // frame is anisotropic — a launch strip is 2.2 along travel and
            // 5.0 across — so one width in q is a different width on the road
            // for every line ANGLE: measured at the wings' own angle, the
            // strip's chevrons came out 1.8x the disc's weight out of the
            // same expression (2.8x for a segment straight along travel).
            float LW = 0.09 * min(r.z, r.w);
            // The box the run fills. An ELLIPSE gets the smaller one because
            // its corners clear a RIM rather than a bounding edge: the
            // rearmost wing tips sit at (BX, BY), and sqrt(BX^2 + BY^2) + LW
            // has to stay inside the 0.9 the edge fade below starts at. A
            // RECTANGLE only has to keep its outermost stroke off that same
            // 0.9 — a rule, not a number, and worth deriving: it comes to
            // 0.86 for the 1.1 x 2.5 strip that ships, and frozen at that it
            // would clip the outer columns on any narrower one.
            float BX = ell ? 0.64 : 0.50;
            float BY = ell ? 0.46 : (0.90 - LW / r.w);
            float GAP_S = 0.24, GAP_L = 0.30;   // of a mark's own size
            float CHEV = 2.0 * BX / (float(rows) + float(rows - 1) * GAP_S);
            float WIDE = 2.0 * BY / (float(cols) + float(cols - 1) * GAP_L);
            // Premultiplied into world ONCE: the loop is then plain world
            // arithmetic, rather than three vec2 multiplies per chevron per
            // fragment — ten of them on a strip, on the hottest path here.
            float X0 = -BX * r.z, SX = CHEV * r.z;
            float PX = CHEV * (1.0 + GAP_S) * r.z;
            float Y0 = (-BY + WIDE * 0.5) * r.w, HY = WIDE * 0.5 * r.w;
            float PY = WIDE * (1.0 + GAP_L) * r.w;
            vec2 wq = vec2(ds, dl);
            float best = 1e9;
            for (int rr = 0; rr < 4; rr++) {
                if (rr >= rows) break;
                float x = X0 + float(rr) * PX;
                for (int cc = 0; cc < 6; cc++) {
                    if (cc >= cols) break;
                    float y = Y0 + float(cc) * PY;
                    // The APEX LEADS: q.x grows with arclength, so the wings
                    // trail. Built the other way round every chevron points
                    // against travel and reads as a brake marking.
                    vec2 apex = vec2(x + SX, y);
                    best = min(best, min(segDist(wq, apex, vec2(x, y - HY)),
                                         segDist(wq, apex, vec2(x, y + HY))));
                }
            }
            // Fade with the entry's own rim so a chevron never ends in mid-air
            // past the edge of the disc or strip it belongs to.
            float edge = 1.0 - smoothstep(0.90, 0.995, d);
            base = mix(base, vec3(0.9911, 0.9137, 0.6105),
                    clamp((1.0 - smoothstep(LW * 0.65, LW, best)) * edge, 0.0, 1.0));
        }
        return base;
    }

    // The deck's own paint — repairs and pads — in the same chunk-local s frame
    // as the decals. Composited BEFORE the rubber tap, which is the whole
    // reason it is not just more entries in the decal arrays.
    vec3 deckPaint(vec3 base, highp float sLocal, float lat) {
        int n = min(materialParams.paintCount, 8);
        for (int i = 0; i < n; i++) {
            highp vec4 r = materialParams.paintRect[i];
            highp float ds = sLocal - r.x;
            if (abs(ds) >= r.z) continue;           // cheap reject, as in the decals
            float dl = lat - r.y;
            if (abs(dl) >= r.w) continue;           // and the deck flag for free
            base = paintStamp(base, r, materialParams.paintColor[i],
                    materialParams.paintShape[i], ds, dl);
        }
        return base;
    }

    // PROFILE stamps: statics (item-box shadows, oil slicks) then boost auras,
    // composited in the order the shell packs them. A mix REPLACES what is under
    // it, so that order is the shell's business and this loop just honours it
    // (TtpRendererFrame's auraDecals has the why).
    //
    // The loop is bounded by profCount, a uniform, so it is uniform-coherent,
    // and the first thing each iteration does is reject on |ds| — most decals on
    // a track are nowhere near any given fragment, so the common path is one
    // subtract and one compare.
    vec3 deckProfiles(vec3 base, highp float sLocal, float lat) {
        int n = min(materialParams.profCount, 8);
        for (int i = 0; i < n; i++) {
            highp vec4 r = materialParams.profRect[i];
            highp float ds = sLocal - r.x;
            if (abs(ds) >= r.z) continue;               // cheap reject
            float dl = lat - r.y;
            if (abs(dl) >= r.w) continue;
            base = paintStamp(base, r, materialParams.profColor[i],
                    materialParams.profShape[i], ds, dl);
        }
        return base;
    }

    // MASKED stamps: the NEAR cars' contact shadows, OVER the profiles and
    // OVER the carShadow tap — a mix replaces, and in the LOD crossfade band
    // a car carries BOTH representations with complementary alphas, so the
    // masked one must land last. See maskRect for why this loop is only ever
    // 0-4 entries: the budget is four, handed out per view.
    vec3 deckMasked(vec3 base, highp float sLocal, float lat) {
        int n = min(materialParams.maskCount, 4);
        highp vec3 uwp = getUserWorldPosition();
        for (int i = 0; i < n; i++) {
            highp vec4 r = materialParams.maskRect[i];
            highp float ds = sLocal - r.x;
            if (abs(ds) >= r.z) continue;
            float dl = lat - r.y;
            if (abs(dl) >= r.w) continue;
            highp vec4 wp = materialParams.maskWPos[i];
            highp vec4 wf = materialParams.maskWFwd[i];
            highp vec4 wr = materialParams.maskWRight[i];
            highp vec3 rel = uwp - wp.xyz;
            vec2 q = vec2(dot(rel, wf.xyz), dot(rel, wr.xyz));
            float d = max(abs(q.x), abs(q.y));
            if (d >= 0.98) continue;
            vec2 uv = q.yx * 0.5 + 0.5;
            // textureLod, NOT texture: non-uniform flow (the continues above)
            // makes an implicit-derivative sample UB — the ANGLE-Metal
            // flicker taught this once already. One level, so LOD 0 is exact.
            // .a: the RGBA8 array stores coverage in alpha (see the sampler).
            // The uniform branch is TTP_DEBUG_DECAL_MASK_FLAT — the probe
            // that prices this fetch's execution (ttp_display.h).
            float m = getMaterialGlobal0().z > 0.0 ? 1.0
                    : textureLod(materialParams_decalMask, vec3(uv, wp.w), 0.0).a;
            m *= 1.0 - smoothstep(0.72, 0.98, d);
            base = mix(base, materialParams.maskInk.rgb, clamp(wf.w * m, 0.0, 1.0));
        }
        return base;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Unlit adds `emissive` to `baseColor`; all the shading goes in the
        // former so nothing else in the pipeline touches it.
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);

        // The light is variable_fog.yzw, BAKED per vertex at track build — see
        // the vertex block. Nothing in either stage reads the normal any more.
        vec3 base = getColor().rgb;

        // THE DECK MASK IS A PER-VERTEX FLAG, NOT A THRESHOLD. One was in this
        // shader twice and was wrong both times. While v was lat/half it EXCLUDED
        // REAL ROAD — the fixed cross-section offsets divided by a small half push
        // deck vertices past 1 where the track narrows — and once v became raw
        // world lat the same constant silently clipped every decal to the middle
        // 2u of a 5u road, which reads as a wedge cut out of the aura rather than
        // as a missing mask.
        //
        // A mask is needed all the same: the road's section is a CLOSED ring, so
        // its underside carries the deck's own lat range and took every decal with
        // it (on a LOOP, a boost aura stuck to the outside). So buildRoadMesh
        // writes an out-of-band v on every vertex that is NOT the flat top
        // surface, and the per-decal |dl| reject above drops it for free — which
        // is also what makes a FULL-WIDTH decal (the launch strips, if they ever
        // move here) safe.
        highp vec2 tc = getUV0();
        // ONE wrap for both channels below: fold this fragment's arclength into
        // the chunk's local frame, the short way round the lap. Every paint and
        // decal x is stored relative to the same centre, so each per-entry test
        // is then a subtract and a compare.
        highp float L = materialParams.trackLength;
        highp float sLocal = tc.x - materialParams.chunkMid;
        if (L > 0.0) sLocal -= L * floor(sLocal * materialParams.invTrackLength + 0.5);

        // Paint, THEN rubber, THEN decals. The middle one is the ordering rule:
        // a repair or a pad is the deck's own surface, so laid rubber runs
        // across it, while a contact shadow, an aura or an oil film is laid ON
        // the deck and composites over the rubber the way it would over the
        // asphalt itself. The out-of-band v of kerbs and underside lands past
        // the ink texture's lat span, clamps to an edge row the stamper never
        // writes, and reads zero ink — the deck flag for free.
        //
        // suv serves BOTH track-space layers (rubber, and the car-shadow tap
        // below) — the shadow layer is deliberately built on the rubber
        // layer's exact lat span so no second mapping exists to drift. highp
        // for the same Metal-fp16 reason as the decal uniforms: u = s/L near
        // 1.0 at half precision steps by ~0.0005 — half a texel of an 8k-wide
        // layer — and mediump would smear the marks.
        highp vec2 suv = vec2(tc.x * materialParams.invTrackLength,
                tc.y * materialParams.invSkidLatSpan + 0.5);
        if (materialParams.paintCount > 0) base = deckPaint(base, sLocal, tc.y);
        float lh = materialParams.skidLatHalf;
        if (lh > 0.0) {
            // The layer is a CPU-rasterized UPLOAD (row 0 = -latHalf), not a
            // render target, so the read is raw — uploads have no
            // per-backend flip. See tests/render-target-uv.test.js.
            float ink = texture(materialParams_skidLayer, suv).r;
            vec4 sc = materialParams.skidColor;
            base = mix(base, sc.rgb, min(ink, sc.a));
        }
        // A box in front of the loop — see profBounds. Exact, not conservative:
        // a box IS the union of the per-entry windows its loop tests, so a
        // fragment it rejects had nothing to draw.
        // AUDITION: the blob tap moved BEFORE the profiles, so a boost
        // aura composites OVER the shadow — at the new near-opaque blob
        // depth, shadow-over-aura turned the aura's designed ~1.8 Hz
        // pulse into a visible wave around the blob's hard edge.
        float csw = materialParams.maskInk.w;
        if (csw > 0.0) {
            float cs = texture(materialParams_carShadow, suv).r;
            // VARIANT C' AUDITION: cut the smear's tail but keep ~1.5
            // texels of transition — a razor edge draws the per-frame
            // raster's sub-texel movement as flicker (the silhouette bake's
            // penumbra note), so the band is the anti-flicker slack.
            base = mix(base, materialParams.maskInk.rgb,
                    min(cs, csw) * smoothstep(0.06, 0.27, cs));
        }
        if (materialParams.profCount > 0) {
            highp vec4 pb = materialParams.profBounds;
            if (sLocal >= pb.x && sLocal <= pb.y && tc.y >= pb.z && tc.y <= pb.w) {
                base = deckProfiles(base, sLocal, tc.y);
            }
        }
        // The car shadows, OVER the profiles — a shadow stays visible through
        // an aura it crosses, and a mix replaces, so the order is structural.
        // ONE tap for the whole field, in UNIFORM control flow (the guard is
        // a uniform), so texture() is sound here like the rubber tap above.
        // min() against maskInk.w caps two stacked shadows at the depth the
        // old loop's mix-of-mixes reached instead of letting saturating-add
        // run darker.
        // The NEAR cars' true silhouettes, last of all (the hybrid LOD).
        if (materialParams.maskCount > 0) {
            highp vec4 mb = materialParams.maskBounds;
            if (sLocal >= mb.x && sLocal <= mb.y && tc.y >= mb.z && tc.y <= mb.w) {
                base = deckMasked(base, sLocal, tc.y);
            }
        }

        // emissive.w = 0 → no second exposure; both terms are pre-exposed.
        material.emissive = vec4(
                ttpFogMix(ttpGrade(base * variable_fog.yzw), variable_fog.x), 0.0);
    }
}

vertex {
    #include "ttp_fog.inc"

    // TWO smooth terms, in ONE varying. The fog factor is .x — camera-dependent,
    // so it must stay LIVE per vertex — and the matte light is .yzw, which is
    // now a baked ATTRIBUTE rather than an evaluation. The varying layout is
    // unchanged, so the fragment stage did not change at all.
    //
    // WHY THE LIGHT IS BAKED. It moved here from the fragment stage first
    // (worth 7.5 ms of a 720p frame on a PowerVR GE9215 — the same trade the
    // fog made). But per vertex it was still a mat4 multiply, a VERTEX texture
    // tap, a log, a sqrt and two smoothsteps, per road vertex PER FRAME, and
    // every input is static per track: the sun is fixed, the deck never moves,
    // and the cars cast blob decals rather than ESM shadows.
    // TtpRenderer::fillRoadLight evaluates the identical ttpMatteLight (minus
    // the fwidth AA floor, which vvis.mat's bake drops for the same reason)
    // once per track, after bakeShadowMap, and this stage is left with a move.
    void materialVertex(inout MaterialVertexInputs material) {
        material.fog = vec4(ttpFogFactor(material.worldPosition.xyz),
                getCustom0().xyz);
    }
}
