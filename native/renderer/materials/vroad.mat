// The road deck: vlit's shading exactly, plus TRACK-SPACE coordinates and the
// flat decals that used to be laid over the road as separate geometry.
//
// WHY THE ROAD NEEDS ITS OWN MATERIAL. Every deck decal — the boost aura, a car's
// contact shadow, a banana's blob, and in time the pads, launch strips and oil
// slicks — used to be a second mesh floating a hair above the deck. That hair is
// unavoidable for a separate mesh: the road is a chord approximation of a curved
// surface and so is the decal, at a different vertex spacing, so the two do not
// coincide and whichever sags further loses. Shading the decal INTO the road
// removes the question rather than tuning it: the decal fragment IS a road
// fragment, at the road's own depth. No lift, no sag, no polygon offset, and no
// render-order to get wrong.
//
// vlit could not simply grow a uv0 channel: buildMesh hands vlit's default
// instance to EVERY mesh that carries normals (hills, structures, berms, scenery,
// props), so requiring uv0 there would mean a UV buffer on all of them.
//
// THE COORDINATES ARE (s, lat), written by buildRoadMesh into uv0, both in WORLD
// units: arclength along the centreline, and lateral offset from it. Nothing is
// normalised — v was lat/half at first so the deck could be masked with |v| <= 1,
// and that needed two independently-computed half-widths to agree. See the mask
// note in material() for how that failed.
//
// Track space is also why this handles the geometry the old approach could not:
// a fragment carries its OWN s, so a loop — where one (x, z) has two different
// arclengths stacked above each other — is unambiguous, and a decal follows every
// crest, dip and bank without anything being conformed to anything.
material {
    name : TtpVroad,
    requires : [
        color,
        // the world normal the Lambert term needs (getWorldGeometricNormalVector)
        tangents,
        // (s, lat) in world units — see above
        uv0
    ],
    shadingModel : unlit,
    culling : none,
    doubleSided : true,
    // uv0 IS NOT A TEXTURE COORDINATE HERE, it is track space (s, lat), and
    // Filament flips V by default for the usual image-origin reason. Left on,
    // getUV0().y comes back as 1 - lat, which is not obviously wrong at a glance
    // and quietly puts every decal in the wrong place: the match lands where
    // 1 - lat equals the decal's lat, i.e. over by the far kerb. Off.
    flipUV : false,
    parameters : [
        // — shading, identical to vlit's and filled by the same bindShadowMap —
        { type : sampler2d, name : shadowMap, precision : high },
        { type : mat4, name : shadowFromWorld, precision : high },
        { type : float, name : shadowTexel },
        { type : float, name : shadowK },
        { type : float, name : shadowDepthScale },

        // — deck decals —
        // How many of the arrays below are live. 0 makes this material identical
        // to vlit, which is how it ships until the decal pass is wired up.
        { type : int, name : decalCount },
        // Lap length, for the wrap: s is periodic, so a decal near the lap line
        // must still reach fragments on the other side of it.
        // PRECISION IS LOAD-BEARING on every decal parameter that carries
        // world units. A default-precision uniform is mediump, and matc's
        // Metal backend takes mediump at its word: the fp32 in the buffer is
        // ROUNDED THROUGH half ON LOAD. At an arclength of 500 an fp16 step
        // is 0.5 of a unit — the car shadow's world anchor quantized by half
        // a car length, which read as no shadow at all with flickering
        // garbage at the quantization crossings. Desktop GL promotes mediump
        // to fp32, which is why the web never showed it.
        { type : float, name : trackLength, precision : high },
        // 1/trackLength, and the arclength this chunk is centred on. Together
        // they take the lap wrap OUT of the per-decal loop: the fragment folds
        // its own arclength into the chunk's local frame ONCE, and each decal is
        // then a plain subtract. The wrap was a divide and a floor per decal per
        // fragment, which is the single most expensive thing that loop did.
        { type : float, name : invTrackLength, precision : high },
        { type : float, name : chunkMid, precision : high },
        // Per decal, in track space:
        //   xy = centre (s, lat), zw = half-extents — ALL world units, matching
        // uv0 exactly, EXCEPT that x arrives relative to this chunk's centre
        // (see chunkMid) so the loop needs no per-decal lap wrap.
        { type : float4[32], name : decalRect, precision : high },
        //   rgb = colour, a = peak alpha
        { type : float4[32], name : decalColor },
        //   x = inner radius fraction held at full alpha, beyond which it
        //       feathers to nothing at 1.0 (the boost aura's 0.72 profile)
        //   y = SHAPE: 0 rectangle, 1 ellipse
        //   z = alpha at the inner knee (the profile is two straight segments,
        //       1 -> knee across 0..inner, then knee -> 0 out to the rim)
        //   w = CHEVRON grid — see paintShape below. No decal packs one today
        //       (the pads that did are paint now); the field is here because
        //       paintStamp reads one layout for both channels.
        { type : float4[32], name : decalShape },
        // MASKED decals — the car ground shadows, whose shape is a baked
        // silhouette rather than a profile the shader could evaluate:
        //   x = sin, y = cos of the car's heading against the track tangent
        //       (kept for the packed-float readback; the mask itself samples
        //       the world-plane projection below)
        //   z = decalMask layer holding this car's silhouette
        //   w = 1 marks the decal masked; 0 is every profile decal above
        { type : float4[32], name : decalTexRot },
        // The masked decal's WORLD anchor: the DECK point under the car and
        // the deck-plane axes at the car's in-plane heading. The mask samples
        // a RIGID PLANAR projection of the fragment's world position onto
        // these; track space only bounds the stamp. Painted in curvilinear
        // (s, lat) instead, the silhouette bends around every corner and the
        // per-triangle kinks of the interpolated field ripple through its
        // sharp edge as the car crosses rings — edge shimmer on bends, gone
        // flat. It read the CAR's own axes until 2026-08-02 — equivalent, the
        // sim never lets the car leave the deck plane — and the deck spelling
        // is the clearer one, not a fix. Zero on profile decals.
        { type : float4[32], name : decalWPos, precision : high },
        { type : float4[32], name : decalWFwd, precision : high },
        { type : float4[32], name : decalWRight, precision : high },
        // One 2D-array texture, one silhouette per layer: 0..7 the cars in
        // slot order, 8 the monster rig, 9 the generic superellipse. Baked
        // and pre-blurred by bakeSilhouette, so this samples ONCE.
        { type : sampler2dArray, name : decalMask },

        // — the paint channel: the deck's OWN surface (repairs, boost pads) —
        // Identical entry layout to the decal arrays above and painted by the
        // same function; the ONLY difference is which side of the rubber tap it
        // composites on (buildDeckPaint has the why). Static per track, so the
        // renderer writes these once at build, per chunk, in the same
        // chunk-local s frame as decalRect.
        { type : int, name : paintCount },
        { type : float4[8], name : paintRect, precision : high },
        { type : float4[8], name : paintColor },
        //   xyz as decalShape; w = CHEVRON grid, packed as cols*10 + rows (cols
        //       ACROSS the lane, rows ALONG travel). 0 for a plain stamp;
        //       anything else overlays that grid in cream, which is what makes a
        //       boost pad or launch strip expressible without a texture: a
        //       chevron is two line segments and a distance to a segment is four
        //       instructions.
        { type : float4[8], name : paintShape },

        // — the rubber layer —
        // Skid marks accumulated in TRACK SPACE: an R8 texture the renderer
        // stamps trail segments into (vskid.mat), mapped u = s / trackLength
        // (REPEAT carries the lap wrap), v = lat across ±skidLatHalf. The
        // channel is the mark's ALPHA already — strength and the old pool's
        // SKID_MAX_OPACITY are folded in at stamp time — and it is PERMANENT
        // until the race-restart wipe: no decay pass exists, on purpose.
        { type : sampler2d, name : skidLayer },
        // Half the lat span the texture covers. 0 disables the tap entirely,
        // which is the no-track / torn-down state.
        { type : float, name : skidLatHalf },
        // rgb = SKID_COLOR in linear (srgbToLinear stays C++-side, one source),
        // a = the cap on summed ink, so crossing trails darken but a donut spot
        // cannot go pure black.
        { type : float4, name : skidColor }
    ]
}

fragment {
    #include "ttp_shade.inc"
    #include "ttp_grade.inc"

    // Distance from p to the segment ab. Four instructions, and it is what lets
    // a boost pad's chevrons be drawn without a texture: the art the mesh used to
    // stroke is two segments per chevron, and the shader can measure them.
    float segDist(vec2 p, vec2 a, vec2 b) {
        vec2 pa = p - a, ba = b - a;
        float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
        return length(pa - ba * h);
    }

    // ONE stamp — a profile fill plus its optional chevron grid — given the
    // fragment's offset (ds, dl) from the entry's centre in world units. Shared
    // by BOTH channels on purpose: paint and decals differ only in which side of
    // the rubber tap they composite on, so a boost pad must not look different
    // for having changed sides. Returns `base` unchanged outside the shape.
    vec3 paintStamp(vec3 base, highp vec4 r, vec4 col, vec4 shape,
            highp float ds, float dl) {
        vec2 q = vec2(ds / r.z, dl / r.w);
        bool ell = shape.y > 0.5;
        float d = ell ? length(q) : max(abs(q.x), abs(q.y));
        if (d >= 1.0) return base;
        // Two straight segments: 1 -> knee across 0..inner, then knee -> 0
        // out to the rim. That is the profile the meshes baked into their
        // vertex alpha, reproduced exactly rather than approximated.
        float inner = shape.x, knee = shape.z;
        float prof = d <= inner
                ? mix(1.0, knee, inner > 0.0 ? d / inner : 0.0)
                : knee * (1.0 - (d - inner) / max(1.0 - inner, 1e-4));
        base = mix(base, col.rgb, clamp(col.a * prof, 0.0, 1.0));

        // CHEVRONS, laid out in the entry's normalised frame and MEASURED in
        // world units: cols ACROSS the lane and rows ALONG travel, packed as
        // cols*10 + rows. That is what makes a boost pad or a launch strip
        // expressible without a texture — a chevron is two line segments and
        // a distance to a segment is four instructions. The counts belong to
        // buildDeckPaint; the caps below are 4 rows and 6 cols, and packing
        // more silently draws fewer.
        int packed = int(shape.w + 0.5);
        int cols = packed / 10, rows = packed - cols * 10;
        if (rows > 0) {
            // A MARGIN PLUS A PACKED RUN, not one chevron per grid cell.
            // Cell centres put more air BETWEEN the marks than AROUND them:
            // the disc's three sat two of their own depths apart with the
            // rearmost running its wing tips past the rim, and the strip's
            // outer columns ran off the paint. Here the gap is a fraction of
            // a mark's own size and the margin is whatever is left of the
            // box, which with these numbers leaves the margin comfortably
            // the larger (0.14 against a 0.083 gap across the strip).
            //
            // THE STROKE IS A WORLD WIDTH, which is why the distance below is
            // taken in world units (ds, dl) rather than in q. The normalised
            // frame is anisotropic — a launch strip is 2.2 along travel and
            // 5.0 across — so one width in q is a different width on the road
            // for every line ANGLE: measured at the wings' own angle, the
            // strip's chevrons came out 1.8x the disc's weight out of the
            // same expression (2.8x for a segment straight along travel).
            float LW = 0.09 * min(r.z, r.w);
            // The box the run fills. An ELLIPSE gets the smaller one because
            // its corners clear a RIM rather than a bounding edge: the
            // rearmost wing tips sit at (BX, BY), and sqrt(BX^2 + BY^2) + LW
            // has to stay inside the 0.9 the edge fade below starts at. A
            // RECTANGLE only has to keep its outermost stroke off that same
            // 0.9 — a rule, not a number, and worth deriving: it comes to
            // 0.86 for the 1.1 x 2.5 strip that ships, and frozen at that it
            // would clip the outer columns on any narrower one.
            float BX = ell ? 0.64 : 0.50;
            float BY = ell ? 0.46 : (0.90 - LW / r.w);
            float GAP_S = 0.24, GAP_L = 0.30;   // of a mark's own size
            float CHEV = 2.0 * BX / (float(rows) + float(rows - 1) * GAP_S);
            float WIDE = 2.0 * BY / (float(cols) + float(cols - 1) * GAP_L);
            // Premultiplied into world ONCE: the loop is then plain world
            // arithmetic, rather than three vec2 multiplies per chevron per
            // fragment — ten of them on a strip, on the hottest path here.
            float X0 = -BX * r.z, SX = CHEV * r.z;
            float PX = CHEV * (1.0 + GAP_S) * r.z;
            float Y0 = (-BY + WIDE * 0.5) * r.w, HY = WIDE * 0.5 * r.w;
            float PY = WIDE * (1.0 + GAP_L) * r.w;
            vec2 wq = vec2(ds, dl);
            float best = 1e9;
            for (int rr = 0; rr < 4; rr++) {
                if (rr >= rows) break;
                float x = X0 + float(rr) * PX;
                for (int cc = 0; cc < 6; cc++) {
                    if (cc >= cols) break;
                    float y = Y0 + float(cc) * PY;
                    // The APEX LEADS: q.x grows with arclength, so the wings
                    // trail. Built the other way round every chevron points
                    // against travel and reads as a brake marking.
                    vec2 apex = vec2(x + SX, y);
                    best = min(best, min(segDist(wq, apex, vec2(x, y - HY)),
                                         segDist(wq, apex, vec2(x, y + HY))));
                }
            }
            // Fade with the entry's own rim so a chevron never ends in mid-air
            // past the edge of the disc or strip it belongs to.
            float edge = 1.0 - smoothstep(0.90, 0.995, d);
            base = mix(base, vec3(0.9911, 0.9137, 0.6105),
                    clamp((1.0 - smoothstep(LW * 0.65, LW, best)) * edge, 0.0, 1.0));
        }
        return base;
    }

    // The deck's own paint — repairs and pads — in the same chunk-local s frame
    // as the decals. Composited BEFORE the rubber tap, which is the whole
    // reason it is not just more entries in the decal arrays.
    vec3 deckPaint(vec3 base, highp float sLocal, float lat) {
        int n = min(materialParams.paintCount, 8);
        for (int i = 0; i < n; i++) {
            highp vec4 r = materialParams.paintRect[i];
            highp float ds = sLocal - r.x;
            if (abs(ds) >= r.z) continue;           // cheap reject, as in the decals
            float dl = lat - r.y;
            if (abs(dl) >= r.w) continue;           // and the deck flag for free
            base = paintStamp(base, r, materialParams.paintColor[i],
                    materialParams.paintShape[i], ds, dl);
        }
        return base;
    }

    // Everything a deck decal contributes at this fragment, composited in the
    // order the array is given — which is the order the shell packs them:
    // statics, then boost auras, then the contact shadows and blobs over both.
    // A mix REPLACES what is under it, so that order is the shell's business
    // and this loop just honours it (TtpRendererFrame's auraDecals has the why).
    //
    // The loop is bounded by decalCount, a uniform, so it is uniform-coherent,
    // and the first thing each iteration does is reject on |ds| — most decals on
    // a track are nowhere near any given fragment, so the common path is one
    // subtract and one compare.
    vec3 deckDecals(vec3 base, highp float sLocal, float lat) {
        int n = min(materialParams.decalCount, 32);
        for (int i = 0; i < n; i++) {
            highp vec4 r = materialParams.decalRect[i];
            vec4 trot = materialParams.decalTexRot[i];
            bool masked = trot.w > 0.5;
            // A masked decal is ROTATED in track space (rect.zw are the halves
            // in the CAR's frame), so its axis-aligned reach here is neither
            // r.z nor its half-diagonal: this test is in TRACK SPACE, where the
            // s axis is an ARCLENGTH and the stamp's halves are WORLD lengths.
            // The deck's iso-arclength lines fan on a bend, so the same world
            // reach spans R/(R−lat) more arclength off the centreline — a
            // constant cannot express it at all, and the one that used to stand
            // here closed inside the stamp and sheared its nose off through
            // every corner. The shell MEASURES the reach per frame instead (see
            // TtpRendererFrame's shadow block) and rides it in the w slots of
            // the two axis vectors. foldToChunk reads the same slot — keep the
            // two in step.
            float boundS = masked ? materialParams.decalWFwd[i].w : r.z;
            float boundL = masked ? materialParams.decalWRight[i].w : r.w;
            highp float ds = sLocal - r.x;
            if (abs(ds) >= boundS) continue;            // cheap reject
            float dl = lat - r.y;
            if (abs(dl) >= boundL) continue;
            if (masked) {
                // Into the car's frame via the WORLD plane, not track space:
                // (s, lat) here only ran the bounds reject above. The user
                // world position, NOT getWorldPosition() — Filament renders
                // camera-relative, and the camera-offset flavour slides the
                // stamp with the chase cam (ttp_shade.inc, same trap).
                highp vec3 rel = getUserWorldPosition()
                        - materialParams.decalWPos[i].xyz;
                float pf = dot(rel, materialParams.decalWFwd[i].xyz);
                float pr = dot(rel, materialParams.decalWRight[i].xyz);
                vec2 q = vec2(pf / r.z, pr / r.w);
                if (max(abs(q.x), abs(q.y)) >= 1.0) continue;
                // u runs ACROSS the car (+right), v ALONG it (+forward) —
                // the handedness bakeSilhouette's up-looking camera bakes.
                vec2 uv = q.yx * 0.5 + 0.5;
                // textureLod, NOT texture: this sample sits in NON-UNIFORM
                // control flow (the rejects above `continue` per fragment), so
                // an implicit-derivative sample is undefined behaviour — and on
                // ANGLE's Metal backend it came out as the stamp intermittently
                // rendering nothing for a few frames at a time, which read as
                // the car's shadow flickering. It vanished under every debug
                // variant of this shader, because any reshape of the code moved
                // the UB. The mask has one mip level, so LOD 0 is the same
                // texels.
                float m = textureLod(materialParams_decalMask,
                        vec3(uv, trot.z), 0.0).a;
                // FEATHER THE WINDOW. The bake's penumbra is not zero at the
                // quad edge, so the |q| >= 1 cutoff above prints as a HARD
                // line wherever the tail crosses bright paint — invisible on
                // bare asphalt, a visible bite on a dash or an edge line, and
                // it slides and kinks with the car. The silhouette proper ends
                // at |q| = 1/1.45 (the bake overscan), so a ramp from 0.72
                // touches only the tail.
                m *= 1.0 - smoothstep(0.72, 0.98, max(abs(q.x), abs(q.y)));
                vec4 mcol = materialParams.decalColor[i];
                base = mix(base, mcol.rgb, clamp(mcol.a * m, 0.0, 1.0));
                continue;
            }
            base = paintStamp(base, r, materialParams.decalColor[i],
                    materialParams.decalShape[i], ds, dl);
        }
        return base;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Unlit adds `emissive` to `baseColor`; all the shading goes in the
        // former so nothing else in the pipeline touches it.
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);

        highp vec3 n = getWorldGeometricNormalVector();
        vec3 base = getColor().rgb;

        // THE DECK MASK IS A PER-VERTEX FLAG, NOT A THRESHOLD. One was in this
        // shader twice and was wrong both times. While v was lat/half it EXCLUDED
        // REAL ROAD — the fixed cross-section offsets divided by a small half push
        // deck vertices past 1 where the track narrows — and once v became raw
        // world lat the same constant silently clipped every decal to the middle
        // 2u of a 5u road, which reads as a wedge cut out of the aura rather than
        // as a missing mask.
        //
        // A mask is needed all the same: the road's section is a CLOSED ring, so
        // its underside carries the deck's own lat range and took every decal with
        // it (on a LOOP, a boost aura stuck to the outside). So buildRoadMesh
        // writes an out-of-band v on every vertex that is NOT the flat top
        // surface, and the per-decal |dl| reject above drops it for free — which
        // is also what makes a FULL-WIDTH decal (the launch strips, if they ever
        // move here) safe.
        highp vec2 tc = getUV0();
        // ONE wrap for both channels below: fold this fragment's arclength into
        // the chunk's local frame, the short way round the lap. Every paint and
        // decal x is stored relative to the same centre, so each per-entry test
        // is then a subtract and a compare.
        highp float L = materialParams.trackLength;
        highp float sLocal = tc.x - materialParams.chunkMid;
        if (L > 0.0) sLocal -= L * floor(sLocal * materialParams.invTrackLength + 0.5);

        // Paint, THEN rubber, THEN decals. The middle one is the ordering rule:
        // a repair or a pad is the deck's own surface, so laid rubber runs
        // across it, while a contact shadow, an aura or an oil film is laid ON
        // the deck and composites over the rubber the way it would over the
        // asphalt itself. The out-of-band v of kerbs and underside lands past
        // the ink texture's lat span, clamps to an edge row the stamper never
        // writes, and reads zero ink — the deck flag for free.
        if (materialParams.paintCount > 0) base = deckPaint(base, sLocal, tc.y);
        float lh = materialParams.skidLatHalf;
        if (lh > 0.0) {
            // highp for the same Metal-fp16 reason as the decal uniforms:
            // u = s/L near 1.0 at half precision steps by ~0.0005 — half a
            // texel of a 16k-wide layer — and mediump would smear the marks.
            highp vec2 suv = vec2(tc.x * materialParams.invTrackLength,
                    (tc.y + lh) / (2.0 * lh));
            // The layer is an offscreen render target, so the read goes
            // through uvToRenderTargetUV (identity on GL, the y-flip on
            // Metal/Vulkan) — see tests/render-target-uv.test.js.
            float ink = texture(materialParams_skidLayer,
                    uvToRenderTargetUV(suv)).r;
            vec4 sc = materialParams.skidColor;
            base = mix(base, sc.rgb, min(ink, sc.a));
        }
        if (materialParams.decalCount > 0) base = deckDecals(base, sLocal, tc.y);

        // emissive.w = 0 → no second exposure; both terms are pre-exposed.
        material.emissive = vec4(ttpGrade(ttpMatteShade(base, n)), 0.0);
    }
}
