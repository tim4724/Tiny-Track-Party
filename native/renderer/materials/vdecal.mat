// Textured translucent decal — the conformed sheets that hug the road.
//
// Same blend rules as vblend (premultiplied alpha, no depth write, polygon
// offset from the caller), but the SHAPE comes from a texture instead of from
// the mesh's own vertex alpha. The car's ground shadow needs that: a per-vertex
// falloff on a 10×14 grid cannot resolve an edge this tight, so the port's blob
// came out soft and vague. The mask arrives PRE-BLURRED (vblur.mat), so this
// samples it once.
//
// Vertex colour still multiplies through: the per-car opacity animates with
// body pitch (the load cue), and the conform rewrites it every frame.
material {
    name : TtpVdecal,
    requires : [
        color,
        uv0
    ],
    shadingModel : unlit,
    culling : none,
    blending : transparent,
    depthWrite : false,
    flipUV : false,
    parameters : [
        { type : sampler2d, name : albedo }
    ]
}

fragment {
    #include "ttp_grade.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // ONE tap. The penumbra is baked into the mask now — the car silhouette
        // through vblur.mat at load, the generic fallback by construction — so
        // there is nothing left to filter here. It was 25 taps per fragment, per
        // car, per cell, rebuilding the same static blur every frame; and doing
        // it at draw over a 128-px source was also what made the gradient band.
        material.baseColor = getColor() * texture(materialParams_albedo, getUV0());
        // Graded, then premultiplied, as vblend (see ttp_grade.inc).
        material.baseColor.rgb = ttpGrade(material.baseColor.rgb) * material.baseColor.a;
    }
}
