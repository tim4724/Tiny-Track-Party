material {
    name : TtpVblend,
    // The per-vertex fog factor (ttp_fog.inc); .yzw unused.
    variables : [ fog ],
    requires : [
        color
    ],
    shadingModel : unlit,
    culling : none,
    blending : transparent,
    depthWrite : false,
    parameters : [
        { type : sampler2d, name : gradeLut }
    ]
}

fragment {
    #include "ttp_grade.inc"
    #include "ttp_fog.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Filament's `transparent` blending expects PREMULTIPLIED alpha (see
        // surface_shading_lit.fs: "we work in premultiplied alpha mode"). The
        // vertex colours carry straight alpha — without this multiply a vertex
        // at alpha 0 still ADDS its full colour, which turned every soft edge
        // into a solid one: clouds rendered as flat white blobs, the boost aura
        // as a hard teal disc, and skid marks came out LIGHTER than the road.
        material.baseColor = getColor();
        // Graded BEFORE the premultiply, so what gets scaled by alpha is the
        // displayed colour — the scene buffer holds sRGB now (ttp_grade.inc).
        material.baseColor.rgb = ttpFogMix(ttpGrade(material.baseColor.rgb), variable_fog.x) * material.baseColor.a;
    }
}

vertex {
    #include "ttp_fog.inc"

    // The fog factor is the only thing this stage exists for: per vertex, so the
    // fragment pays a mix instead of a sqrt and an exp. See ttp_fog.inc.
    void materialVertex(inout MaterialVertexInputs material) {
        material.fog = vec4(ttpFogFactor(material.worldPosition.xyz), 0.0, 0.0, 0.0);
    }
}
