// Camera-facing round sprite — the ambient-particle cloud (snow, dust, sand,
// pollen). The JS draws these as a THREE.Points cloud with a soft radial
// texture, which is billboarded per camera and perfectly round; a world-space
// polyhedron can be neither, and a diamond is exactly what it looked like.
//
// So the sprite is spun toward the camera IN THE VERTEX SHADER: every particle
// is THREE vertices carrying the same world centre, and uv0 is the corner of a
// triangle circumscribing the unit circle (radius 2 from the centre), pushed
// out along the camera's right/up. The fragment cuts the circle out of it, so
// a triangle draws the same round sprite a quad did for three quarters of the
// vertex work — and on the Android box the cloud is vertex-bound, every corner
// running the whole of this stage. Per VIEW for free — the split-screen cells
// all look in different directions, and one CPU billboard can only ever face
// one of them.
//
// THE CLOUD IS A CHEAT, fully evaluated here in the vertex shader. The mesh
// holds only immutable SEEDS in a boxXZ-wide column; each frame this shader
// applies the kind's motion (fall / wind / bob, from one `time` uniform) and
// wraps the result's x/z around THIS VIEW'S camera, toroidally. Flakes
// therefore exist only where someone can see them — every split-screen cell
// gets its own full box from the same draw — and the CPU never touches the
// vertices again: no drift loop, no per-frame re-upload. Height stays
// ABSOLUTE (the kind's band above the world floor), which is what keeps sand
// hugging the ground and snow falling from above while the camera flies.
//
// Two alpha fades ride along: a rim fade at the wrap boundary so a particle
// dissolves instead of popping in, and the flake-floor fade — a max-height
// grid of terrain + road deck, sampled as a texture — so snow settles onto an
// elevated deck instead of depth-slicing through it. Other kinds bind a 1x1
// "floor at -1000" texel and are untouched by it. `lite` skips that tap and
// the fog term: the renderer sets it for a split's quarter-size cells, where
// the box is shrunk to well inside the fog's onset and a flake failing to
// settle is under the size the eye resolves (TtpRenderer::renderAmbient).
//
// The fragment then rebuilds the sprite texture's radial gradient from the same
// uv (opaque core, 0.9 at 0.4r, out to nothing at the rim), so the silhouette
// is a circle no matter how few vertices are behind it.
//
// THE CUP'S AMBIENT LIFE (theme.life) is a second cloud through this same
// material, and every knob it adds is a uniform that leaves the weather's path
// as it was (each 0 there):
//   - `mask` scales a sprite's alpha by the floor texture's G, the map of
//     where that life lives (round a cherry, by the road), and
//     lays the band on the floor texture's R, the ground under it, so the tap
//     runs in a split's lite cells too;
//   - `tile` (world units) wraps a sprite inside its own seed's tile of the
//     world instead of round the camera: life seeded only where it lives, so
//     a sunbeam's few dozen motes cost a few dozen sprites, not a camera box
//     of them;
//   - `hop` (rad/s) STANDS a sprite on the floor (R) instead of in the band
//     and bounces it: a tumbleweed rolling;
//   - `flutter` turns a sprite edge-on and back, a petal tumbling;
//   - `twig` draws the fragment as a see-through ball of stems, turned by the
//     roll the vertex stage hands over in fog.y.
// A sprite left with no alpha is collapsed to a point, so the cloud's masked
// majority rasterizes nothing.
material {
    name : TtpVpoint,
    // The per-vertex fog factor (ttp_fog.inc); .yzw unused.
    variables : [ fog ],
    requires : [
        color,
        uv0
    ],
    shadingModel : unlit,
    // Fog is ours (ttp_fog.inc); every material filters Filament's variant
    // (tests/material-rules.test.js says why).
    variantFilter : [ fog ],
    culling : none,
    blending : transparent,
    depthWrite : false,
    flipUV : false,
    parameters : [
        { type : float, name : halfSize },
        // World units and long-running seconds — high, or Metal's fp16
        // default quantizes them (see metal notes in the repo memory).
        { type : float, name : time, precision : high },
        { type : float, name : fall },
        { type : float, name : wind },
        { type : float, name : bob },
        { type : float, name : bandH, precision : high },
        { type : float, name : boxXZ, precision : high },
        { type : float, name : lite },
        { type : float2, name : floorOrigin, precision : high },
        { type : float, name : floorInvSpan, precision : high },
        { type : sampler2d, name : floorTex },
        { type : float, name : mask },
        { type : float, name : tile, precision : high },
        { type : float, name : hop },
        { type : float, name : flutter },
        { type : float, name : twig }
    ]
}

vertex {
    #include "ttp_fog.inc"

    void materialVertex(inout MaterialVertexInputs material) {
        highp mat4 w = getWorldFromViewMatrix();
        // Filament renders camera-relative: shader world != API world. The wrap
        // is computed in USER world (the offset is a pure translation) and the
        // result converted back on the way out — same trap vroad.mat documents.
        highp vec3 off = getUserWorldFromWorldMatrix()[3].xyz;
        highp vec3 seed = material.worldPosition.xyz + off;
        highp vec3 camU = w[3].xyz + off;
        highp float t = materialParams.time;
        // Per-particle fall speed and bob phase, from the VERTEX INDEX (the
        // three corners of particle i are indices 3i..3i+2, so /3 lands the
        // sprite on one value). NOT a hash of the seed position: worldPosition
        // reconstructs through the per-frame camera-relative origin, and a
        // sin-fract hash amplifies that reconstruction's fp noise into a NEW
        // random number every frame — the flakes strobed. The index is exact.
        highp float h1 = fract(float(getVertexIndex() / 3) * 0.6180339887);
        highp float speed = 1.1 + 1.4 * h1;
        // Height: the old CPU drift verbatim — absolute band above the world
        // floor, per-particle fall, shared sinusoidal bob.
        highp float y = seed.y - speed * materialParams.fall * t
                + sin(t * 0.7 + h1 * 61.0) * materialParams.bob * 0.3;
        y = mod(y, materialParams.bandH) + 0.5;
        // x/z: ride the wind, then wrap into a boxXZ-wide column centred on
        // the camera (GLSL mod is non-negative, so one mod suffices).
        highp float bx = materialParams.boxXZ;
        // A thing on the floor rolls at its own pace; the weather's wind is one.
        highp float pace = materialParams.hop > 0.0 ? 0.7 + 0.6 * h1 : 1.0;
        highp vec2 p = seed.xz + vec2(materialParams.wind * pace * t, 0.0);
        highp vec2 rel;
        highp vec3 posU;
        if (materialParams.tile > 0.0) {
            // The seed's own tile: the CPU keeps every seed clear of its
            // tile's edges, so worldPosition's reconstruction noise cannot
            // move it to the next one.
            bx = materialParams.tile;
            highp vec2 c = (floor(seed.xz / bx) + 0.5) * bx;
            rel = mod(p - c + 0.5 * bx, vec2(bx)) - 0.5 * bx;
            posU = vec3(c.x + rel.x, y, c.y + rel.y);
        } else {
            rel = mod(p - camU.xz, vec2(bx)) - 0.5 * bx;
            posU = vec3(camU.x + rel.x, y, camU.z + rel.y);
        }
        // Dissolve at the wrap boundary (Chebyshev distance IS the distance to
        // the seam), and fade out against the local surface — an alpha fade
        // only, the vertex is never repositioned — instead of clipping it.
        float edge = 1.0 - smoothstep(0.8, 1.0, max(abs(rel.x), abs(rel.y)) / (0.5 * bx));
        material.color.a *= edge;
        material.fog = vec4(0.0);
        highp vec2 uv = (posU.xz - materialParams.floorOrigin) * materialParams.floorInvSpan;
        if (materialParams.hop > 0.0) {
            highp vec2 f = textureLod(materialParams_floorTex, uv, 0.0).rg;
            float up = abs(sin(t * materialParams.hop + h1 * 61.0));
            posU.y = f.r + materialParams.halfSize + materialParams.bob * up;
            material.color.a *= f.g;
            material.fog.y = materialParams.wind * pace * t / max(materialParams.halfSize, 0.01);
        } else if (materialParams.mask > 0.5) {
            highp vec2 f = textureLod(materialParams_floorTex, uv, 0.0).rg;
            posU.y += f.r;
            // …and in on the band's way down, out as it lands: a band this
            // low is in shot top to bottom.
            material.color.a *= f.g * smoothstep(0.0, 1.0, y - 0.5)
                    * smoothstep(0.0, 1.0, materialParams.bandH + 0.5 - y);
        } else if (materialParams.lite < 0.5) {
            material.color.a *= clamp(y - textureLod(materialParams_floorTex, uv, 0.0).r, 0.0, 1.0);
        }
        float wide = 1.0;
        if (materialParams.flutter > 0.0) wide = 0.2 + 0.8 * abs(cos(t * 2.6 + h1 * 40.0));
        float hs = materialParams.halfSize * step(0.004, material.color.a);
        material.worldPosition.xyz = posU - off
                + (w[0].xyz * (material.uv0.x * wide) + w[1].xyz * material.uv0.y) * hs;
        // LAST: this stage moves worldPosition, and the fog factor has to be
        // measured from where the vertex actually ends up.
        if (materialParams.lite < 0.5) material.fog.x = ttpFogFactor(material.worldPosition.xyz);
    }
}

fragment {
    #include "ttp_fog.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = getColor();
        float d = length(getUV0());
        // makeSnowflakeTexture's stops: 1.0 at the centre, 0.9 at 0.4, 0 at 1.
        float a = d < 0.4 ? 1.0 - 0.25 * d : 0.9 * (1.0 - (d - 0.4) / 0.6);
        if (materialParams.twig > 0.5) {
            // Three families of wavy stems crossing at odd angles, turned by
            // the roll, over a thin fill, inside a ragged outline: a tangle
            // you can see through, not a wheel.
            vec2 q = getUV0();
            float r = variable_fog.y;
            float stems = 0.0;
            for (int k = 0; k < 3; k++) {
                float th = r + float(k) * 2.1;
                vec2 dir = vec2(cos(th), sin(th));
                float v = dot(q, dir) * (2.6 + 0.9 * float(k))
                        + 0.35 * sin(dot(q, vec2(-dir.y, dir.x)) * 4.0 + float(k));
                stems = max(stems, 1.0 - smoothstep(0.07, 0.18, abs(fract(v) - 0.5)));
            }
            float ragged = d + 0.1 * sin(atan(q.y, q.x) * 5.0 + r) + 0.05 * sin(atan(q.y, q.x) * 11.0 - r);
            a = max(stems, 0.28) * (1.0 - smoothstep(0.72, 0.9, ragged));
        }
        material.baseColor.a *= clamp(a, 0.0, 1.0);
        // Premultiply, same as vblend: the vertex colour is displayed already.
        material.baseColor.rgb = ttpFogMix(material.baseColor.rgb, variable_fog.x) * material.baseColor.a;
    }
}
