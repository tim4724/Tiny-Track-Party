// The live-lit matte family, for a mesh that MOVES after build: anything not
// opted into Mesh::bakeLight and not a baked shadow receiver (vground.mat). A
// static surface never comes here, because a mesh that moves would carry baked
// light along with its transform. These receive no sun shadow for the same
// reason: nothing here can be baked, and nothing samples the ESM in a frame
// (ttp_shade.inc).
//
// Lambert. This was Filament's full PBR `lit` model with roughness 1 /
// reflectance 0 — correct-looking, and three times the per-pixel cost of the
// Lambert look it was standing in for.
// So: unlit, with the diffuse terms written out by hand. They are Filament's
// OWN expressions, not an approximation of them —
//   ambient  = Irradiance_SphericalHarmonics(n) * iblLuminance   (light_indirect)
//   sun      = lightColorIntensity.rgb * .w * NoL * Fd_Lambert() (shading_model_standard)
// — read from the same frameUniforms the lit path reads, both already
// pre-exposed. The only thing dropped is the specular.
material {
    name : TtpVlit,
    // fog.x = the per-vertex fog factor (ttp_fog.inc); fog.yzw = the matte
    // light, display-encoded (ttp_shade.inc, ttpMatteLightDisplay). Display
    // values, so mediump (exact to 1/2048 of an 8-bit value).
    variables : [ { name : fog, precision : medium } ],
    requires : [
        color,
        // the world normal the vertex stage's Lambert term needs
        tangents
    ],
    shadingModel : unlit,
    culling : none,
    doubleSided : true
}

fragment {
    #include "ttp_fog.inc"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // The vertex colour is the albedo, display-encoded (packAlbedo); the
        // light arrived encoded too. Straight to baseColor: an unlit material
        // passes it through untouched, where an `emissive` write would add
        // Filament's exposure maths (addEmissive) per fragment for nothing.
        material.baseColor = vec4(ttpFogMix(getColor().rgb * variable_fog.yzw, variable_fog.x), 1.0);
    }
}

vertex {
    #include "ttp_shade.inc"
    #include "ttp_fog.inc"

    // The fog factor in .x and, in .yzw, this vertex's matte light ENCODED FOR
    // DISPLAY (ttpMatteLightDisplay): the fragment multiplies it into the
    // albedo and grades nothing. Per vertex is per face for the kit — its
    // vertices are split at every edge — and smooth over metres elsewhere.
    void materialVertex(inout MaterialVertexInputs material) {
        material.fog = vec4(ttpFogFactor(material.worldPosition.xyz),
                ttpMatteLightDisplay(normalize(material.worldNormal)));
    }
}
